@{
    ViewData["Title"] = "Tổng quan hệ thống";
}

<link rel="stylesheet" href="~/admin/css/Dashboad.css" asp-append-version="true" />
<div class="mb-4">
    <h3 class="fw-bold">Tổng quan hệ thống</h3>
    <p class="text-muted small">Chào mừng quay trở lại, Nguyễn Admin. Đây là báo cáo vận hành hôm nay.</p>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card-custom">
            <div class="d-flex justify-content-between mb-3">
                <div class="p-2 bg-primary-subtle text-primary rounded-3"><i class="bi bi-wallet2 fs-5"></i></div>
                <span class="badge bg-success-subtle text-success rounded-pill align-self-start">+12%</span>
            </div>
            <div class="text-muted small fw-bold">TỔNG DOANH THU</div>
            <h4 class="fw-bold my-1">1.250.000.000</h4>
            <div class="text-muted small">VND • So với tháng trước</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom">
            <div class="d-flex justify-content-between mb-3">
                <div class="p-2 bg-warning-subtle text-warning rounded-3"><i class="bi bi-ticket-detailed fs-5"></i></div>
            </div>
            <div class="text-muted small fw-bold">VÉ ĐÃ BÁN</div>
            <h4 class="fw-bold my-1">3,450</h4>
            <div class="text-success small fw-bold">↑ 8.4% <span class="text-muted fw-normal">tuần này</span></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom bg-primary text-white">
            <div class="d-flex justify-content-between mb-3">
                <div class="p-2 bg-white bg-opacity-25 rounded-3"><i class="bi bi-airplane-engines fs-5"></i></div>
            </div>
            <div class="small opacity-75 fw-bold">CHUYẾN BAY SẮP TỚI</div>
            <h4 class="fw-bold my-1">18 Chuyến</h4>
            <div class="small fw-bold"><i class="bi bi-dot"></i> Đang vận hành</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom">
            <div class="d-flex justify-content-between mb-3">
                <div class="p-2 bg-info-subtle text-info rounded-3"><i class="bi bi-people fs-5"></i></div>
            </div>
            <div class="text-muted small fw-bold">KHÁCH HÀNG MỚI</div>
            <h4 class="fw-bold my-1">256</h4>
            <div class="d-flex mt-2">
                <img src="https://i.pravatar.cc/30?u=a" class="rounded-circle border border-white" style="margin-right: -10px;">
                <img src="https://i.pravatar.cc/30?u=b" class="rounded-circle border border-white" style="margin-right: -10px;">
                <span class="rounded-circle bg-light border border-white d-flex align-items-center justify-content-center fw-bold small" style="width: 30px; height: 30px;">+12</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-8">
        <div class="card-custom">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0">Biểu đồ Doanh thu</h5>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-primary px-3 rounded-start-pill">Năm nay</button>
                    <button class="btn btn-outline-secondary px-3 rounded-end-pill">Năm trước</button>
                </div>
            </div>
            <canvas id="revenueChart" height="280"></canvas>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-custom fleet-card">
            <h5 class="fw-bold mb-4">Tình trạng đội bay</h5>
            <div class="mb-4">
                <div class="d-flex justify-content-between small mb-2"><span>Airbus A350-900</span><span class="fw-bold">12/12</span></div>
                <div class="progress" style="height: 6px; background: rgba(255,255,255,0.1);"><div class="progress-bar bg-success" style="width: 100%"></div></div>
            </div>
            <div class="mb-4">
                <div class="d-flex justify-content-between small mb-2"><span>Boeing 787-10</span><span class="fw-bold">8/8</span></div>
                <div class="progress" style="height: 6px; background: rgba(255,255,255,0.1);"><div class="progress-bar bg-success" style="width: 100%"></div></div>
            </div>
            <div class="mb-4">
                <div class="d-flex justify-content-between small mb-2"><span>Airbus A321neo</span><span class="fw-bold">14/15</span></div>
                <div class="progress" style="height: 6px; background: rgba(255,255,255,0.1);"><div class="progress-bar bg-warning" style="width: 90%"></div></div>
            </div>
            <div class="p-3 rounded-4 bg-white bg-opacity-10 small mt-5">
                <i class="bi bi-info-circle me-2 text-warning"></i> <strong>Thông báo bảo trì:</strong> Boeing 787 (VN-A899) dự kiến bảo trì tại HAN lúc 23:30 tối nay.
            </div>
        </div>
    </div>
</div>

<div class="card-custom">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold mb-0">Chuyến bay hôm nay</h5>
        <a href="#" class="text-primary text-decoration-none small fw-bold">Xem tất cả lịch trình</a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr class="small text-muted">
                    <th>MÃ CHUYẾN BAY</th>
                    <th>HÀNH TRÌNH</th>
                    <th>THỜI GIAN</th>
                    <th>LOẠI MÁY BAY</th>
                    <th>TÌNH TRẠNG</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-bold">VN-128</td>
                    <td class="fw-bold">SGN <i class="bi bi-arrow-right mx-2 opacity-25"></i> HAN</td>
                    <td>14:20 - 16:35</td>
                    <td>Airbus A350</td>
                    <td><span class="status-badge bg-success-subtle text-success">ĐÚNG GIỜ</span></td>
                    <td><i class="bi bi-three-dots-vertical cursor-pointer"></i></td>
                </tr>
                <tr>
                    <td class="fw-bold">QH-204</td>
                    <td class="fw-bold">DAD <i class="bi bi-arrow-right mx-2 opacity-25"></i> SGN</td>
                    <td>15:00 - 16:15</td>
                    <td>Boeing 787</td>
                    <td><span class="status-badge bg-warning-subtle text-warning text-uppercase">Đang làm thủ tục</span></td>
                    <td><i class="bi bi-three-dots-vertical cursor-pointer"></i></td>
                </tr>
                <tr>
                    <td class="fw-bold text-danger">VN-552</td>
                    <td class="fw-bold">SGN <i class="bi bi-arrow-right mx-2 opacity-25"></i> SIN</td>
                    <td>17:10 - 20:15</td>
                    <td>Airbus A350</td>
                    <td><span class="status-badge bg-danger-subtle text-danger">TRỄ (15P)</span></td>
                    <td><i class="bi bi-three-dots-vertical cursor-pointer"></i></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

    <script src="~/admin/js/Dashboad.js" asp-append-version="true" defer></script>
