@{
    ViewData["Title"] = "Quản lý Sân bay và Tuyến bay";
    var airports = ViewBag.Airports as IEnumerable<HeThong_BanVeMayBay.Models.Entities.SanBay>;
    var routes = ViewBag.Routes as IEnumerable<HeThong_BanVeMayBay.Models.Entities.TuyenBay>;
    
    var activeRoutesCount = routes?.Count(r => r.TrangThai == true) ?? 0;
    var maintenanceRoutesCount = routes?.Count(r => r.TrangThai == false) ?? 0;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-navy" style="color: #003580;">Quản lý Hạ tầng bay</h3>
            <p class="text-muted small mb-0">Cấu hình danh sách Sân bay và mạng lưới Tuyến bay khai thác.</p>
        </div>
        <button class="btn rounded-pill px-4 fw-bold text-white shadow-sm" style="background-color: #003580" onclick="openRouteModal()">
            <i class="bi bi-plus-lg me-2"></i>Thêm Tuyến bay mới
        </button>
    </div>

    <!-- Stat Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4" style="border-left: 4px solid #003580 !important;">
                <div class="card-body p-4">
                    <div class="text-muted small fw-bold mb-2">SÂN BAY ĐỐI TÁC</div>
                    <h3 class="fw-bold mb-0">@(airports?.Count() ?? 0) <span class="fs-6 fw-normal text-muted">sân bay</span></h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4" style="border-left: 4px solid #0dcaf0 !important;">
                <div class="card-body p-4">
                    <div class="text-muted small fw-bold mb-2">TUYẾN BAY ĐANG KHAI THÁC</div>
                    <h3 class="fw-bold mb-0">@activeRoutesCount <span class="fs-6 fw-normal text-muted">tuyến</span></h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4" style="border-left: 4px solid #ffc107 !important;">
                <div class="card-body p-4">
                    <div class="text-muted small fw-bold mb-2">TUYẾN BAY BẢO TRÌ</div>
                    <h3 class="fw-bold mb-0" style="color: #ffc107">@maintenanceRoutesCount <span class="fs-6 fw-normal text-muted">tuyến</span></h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs Content Area -->
    <div class="bg-white p-4 rounded-4 shadow-sm">
        
        <!-- Tab Navigation -->
        <ul class="nav nav-pills mb-4 border-bottom pb-3" id="pills-tab" role="tablist">
            <li class="nav-item me-2" role="presentation">
                <button class="nav-link text-muted fw-bold d-flex align-items-center" id="pills-airport-tab" data-bs-toggle="pill" data-bs-target="#pills-airport" type="button" role="tab" aria-selected="false">
                    <i class="bi bi-building me-2"></i>Danh sách Sân bay
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold d-flex align-items-center" style="background-color: #ffc107; color: #000;" id="pills-route-tab" data-bs-toggle="pill" data-bs-target="#pills-route" type="button" role="tab" aria-selected="true">
                    <i class="bi bi-geo-alt me-2"></i>Mạng lưới Tuyến bay
                </button>
            </li>
        </ul>

        <!-- Tab Panes -->
        <div class="tab-content" id="pills-tabContent">
            
            <!-- SÂN BAY TAB -->
            <div class="tab-pane fade" id="pills-airport" role="tabpanel" aria-labelledby="pills-airport-tab" tabindex="0">
                <div class="d-flex justify-content-end mb-3">
                    <button class="btn btn-sm btn-outline-primary fw-bold" onclick="openAddModal()"><i class="bi bi-plus-lg me-1"></i>Thêm Sân bay</button>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle table-hover">
                        <thead class="text-muted small text-uppercase" style="border-bottom: 2px solid #eee;">
                            <tr>
                                <th class="py-3">Mã Sân Bay</th>
                                <th class="py-3">Tên Sân Bay</th>
                                <th class="py-3">Thành Phố / Tỉnh</th>
                                <th class="py-3 text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (airports != null && airports.Any())
                            {
                                foreach (var sb in airports)
                                {
                                    <tr>
                                        <td class="fw-bold" style="color: #003580;">@sb.MaSb</td>
                                        <td class="fw-bold">@sb.TenSb</td>
                                        <td>@sb.ThanhPho</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-light border text-secondary me-1" title="Sửa" onclick="openEditAirport('@sb.MaSb', '@sb.TenSb', '@sb.ThanhPho')"><i class="bi bi-pencil-square"></i></button>
                                            <button class="btn btn-sm btn-light border text-danger" title="Xóa" onclick="confirmDelete('Sân bay @sb.MaSb', 'sb-@sb.MaSb')"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TUYẾN BAY TAB -->
            <div class="tab-pane fade show active" id="pills-route" role="tabpanel" aria-labelledby="pills-route-tab" tabindex="0">
                <div class="table-responsive">
                    <table class="table align-middle table-hover">
                        <thead class="text-muted small text-uppercase" style="border-bottom: 2px solid #eee;">
                            <tr>
                                <th class="py-3">Mã Tuyến</th>
                                <th class="py-3">Hành Trình</th>
                                <th class="py-3">Khoảng Cách</th>
                                <th class="py-3">TG Dự Kiến</th>
                                <th class="py-3">Trạng Thái</th>
                                <th class="py-3 text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(routes != null && routes.Any())
                            {
                                foreach (var route in routes)
                                {
                                    // Hiển thị mã sân bay thay vì tên nếu tên quá dài (giống thiết kế gốc)
                                    var from = route.MaSbdi ?? "N/A";
                                    var to = route.MaSbden ?? "N/A";
                                    <tr>
                                        <td class="fw-bold" style="color: #007bff;">@route.MaTuyen</td>
                                        <td class="fw-bold">@from <i class="bi bi-arrow-right mx-2 text-muted fw-normal"></i> @to</td>
                                        <td>@route.KhoangCach km</td>
                                        <td>@route.ThoiGianBayDuKien phút</td>
                                        <td>
                                            <div class="form-check form-switch ps-0">
                                                <input class="form-check-input ms-0" type="checkbox" role="switch" @(route.TrangThai == true ? "checked" : "") disabled style="cursor: default">
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-light border text-secondary me-1" title="Sửa" onclick="openEditRoute('@route.MaTuyen')"><i class="bi bi-pencil-square"></i></button>
                                            <button class="btn btn-sm btn-light border text-danger" title="Xóa" onclick="confirmDelete('Tuyến bay @route.MaTuyen', 'tb-@route.MaTuyen')"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            
        </div>
    </div>
</div>

<!-- Modal Thêm Sân Bay, Tuyến Bay & Delete giữ nguyên như cũ -->
<!-- ... (Các phần mã HTML Modal bên dưới được giữ nguyên nội dung như script của bạn) -->

<div class="modal fade" id="modalAirport" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="fw-bold mb-0 text-navy" id="titleAirport"><i class="bi bi-building me-2"></i>Thêm Sân bay mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="formAirport" onsubmit="submitForm(event, 'modalAirport')">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">MÃ SÂN BAY (3 KÝ TỰ)</label>
                        <input type="text" class="form-control bg-light border-0 py-2 fw-bold text-uppercase" id="sbMa" placeholder="VD: SGN, HAN..." maxlength="3" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">TÊN SÂN BAY</label>
                        <input type="text" class="form-control bg-light border-0 py-2" id="sbTen" placeholder="VD: Cảng hàng không Quốc tế Tân Sơn Nhất" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">THÀNH PHỐ / TỈNH</label>
                        <input type="text" class="form-control bg-light border-0 py-2" id="sbThanhPho" placeholder="VD: TP. Hồ Chí Minh" required>
                    </div>
                    <button type="submit" class="btn w-100 rounded-pill py-3 fw-bold text-white shadow-sm" style="background: #003580;">LƯU THÔNG TIN</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalRoute" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="fw-bold mb-0 text-navy" id="titleRoute"><i class="bi bi-geo-alt me-2"></i>Thêm Tuyến bay mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="formRoute" onsubmit="submitForm(event, 'modalRoute')">
                    <div class="row g-3 mb-3">
                        <div class="col-5">
                            <label class="form-label small fw-bold text-muted">ĐIỂM ĐI</label>
                            <select class="form-select bg-light border-0 py-2 fw-bold" id="tbDi" required>
                                <option value="">Chọn...</option>
                                @if (airports != null) {
                                    foreach(var sb in airports)
                                    {
                                        <option value="@sb.MaSb">@sb.MaSb - @sb.TenSb</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-2 d-flex align-items-end justify-content-center pb-2">
                            <i class="bi bi-arrow-right fs-4 text-muted"></i>
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-bold text-muted">ĐIỂM ĐẾN</label>
                            <select class="form-select bg-light border-0 py-2 fw-bold" id="tbDen" required>
                                <option value="">Chọn...</option>
                                @if (airports != null) {
                                    foreach(var sb in airports)
                                    {
                                        <option value="@sb.MaSb">@sb.MaSb - @sb.TenSb</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">KHOẢNG CÁCH (KM)</label>
                            <input type="number" class="form-control bg-light border-0 py-2" id="tbKhoangCach" placeholder="VD: 1190" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">T/G BAY DỰ KIẾN (PHÚT)</label>
                            <input type="number" class="form-control bg-light border-0 py-2" id="tbThoiGianBay" placeholder="VD: 125" required>
                        </div>
                    </div>
                    <button type="submit" class="btn w-100 rounded-pill py-3 fw-bold text-white shadow-sm" style="background: #003580;">LƯU TUYẾN BAY</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDelete" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content shadow-lg text-center p-4" style="border-radius: 20px;">
            <i class="bi bi-exclamation-triangle-fill text-danger display-4 mb-3"></i>
            <h5 class="fw-bold mb-2">Xác nhận xóa?</h5>
            <p class="text-muted small mb-4">Bạn có chắc muốn xóa <strong id="delName" class="text-dark"></strong> không? Thao tác không thể phục hồi.</p>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light w-50 rounded-pill fw-bold" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger w-50 rounded-pill fw-bold" onclick="executeDelete()">Xóa bỏ</button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 1060; margin-top: 20px;">
    <div id="liveToast" class="toast align-items-center text-white bg-success border-0 shadow-lg rounded-pill px-4 py-3" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-bold fs-6 p-0" id="toastMessage">Thao tác thành công!</div>
        </div>
    </div>
</div>

<script src="~/admin/js/SanBayVaTuyenBay.js" asp-append-version="true" defer></script>

