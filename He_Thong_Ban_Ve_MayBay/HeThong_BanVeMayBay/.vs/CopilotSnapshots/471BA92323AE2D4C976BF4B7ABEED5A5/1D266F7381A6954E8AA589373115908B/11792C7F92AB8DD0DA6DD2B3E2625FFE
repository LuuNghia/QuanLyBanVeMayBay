@model IEnumerable<HeThong_BanVeMayBay.Models.Entities.ChuyenBay>
@{
    ViewData["Title"] = "Quản lý Chuyến bay";

    // Tính toán số liệu thống kê từ Model
    var totalFlights = Model?.Count() ?? 0;
    var onTimeFlights = Model?.Count(f => f.TrangThai == "Đúng giờ") ?? 0;
    var delayFlights = Model?.Count(f => f.TrangThai == "Delay") ?? 0;
    var onTimePercentage = totalFlights > 0 ? (onTimeFlights * 100.0 / totalFlights).ToString("0.0") : "0";
    var popularPlane = Model?.GroupBy(f => f.MaLoaiMbNavigation?.TenLoaiMb).OrderByDescending(g => g.Count()).FirstOrDefault()?.Key ?? "N/A";
}

@section Styles {
    <link href="~/admin/css/QuanLyChuyenBay.css" rel="stylesheet" asp-append-version="true" />
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb text-muted">
        <li class="breadcrumb-item">Hệ thống</li>
        <li class="breadcrumb-item active text-primary">Quản lý Chuyến bay</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-navy mb-1">Điều hành Chuyến bay</h2>
        <p class="text-muted small mb-0">Cập nhật và theo dõi lộ trình bay trong thời gian thực.</p>
    </div>
    <button class="btn btn-add" data-bs-toggle="modal" data-bs-target="#modalFlight" style="background: var(--primary-navy, #003580); color: white; border-radius: 50px; padding: 10px 25px; font-weight: bold; border: none;">
        <i class="bi bi-plus-lg me-2"></i>Thêm Chuyến bay
    </button>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card-custom d-flex justify-content-between align-items-center" style="background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
            <div>
                <div class="stat-label small fw-bold text-muted text-uppercase mb-1">Tổng chuyến bay</div>
                <h3 class="fw-bold mb-0">@totalFlights</h3>
            </div>
            <span class="badge bg-primary-subtle text-primary rounded-pill">Chuyến</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom" style="background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
            <div class="stat-label small fw-bold text-muted text-uppercase mb-1">Đúng giờ</div>
            <div class="d-flex align-items-center">
                <h3 class="fw-bold mb-0 me-3">@onTimeFlights</h3>
                <span class="text-success small fw-bold">@onTimePercentage%</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom" style="background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
            <div class="stat-label small fw-bold text-muted text-uppercase mb-1">Đang Delay</div>
            <div class="d-flex align-items-center">
                <h3 class="fw-bold mb-0 me-3 text-danger">@delayFlights</h3>
                <span class="badge bg-danger-subtle text-danger rounded-pill">Chú ý</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom" style="background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
            <div class="stat-label small fw-bold text-muted text-uppercase mb-1">Loại máy bay</div>
            <div class="d-flex align-items-center">
                <h3 class="fw-bold mb-0 me-3">@popularPlane</h3>
                <span class="badge bg-warning-subtle text-warning rounded-pill">Phổ biến</span>
            </div>
        </div>
    </div>
</div>

<div class="table-container mb-5" style="background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold mb-0">Danh sách lộ trình</h5>
        <div class="d-flex gap-2">
            <button class="btn btn-light btn-sm rounded-pill px-3 active fw-bold" style="background: #003580; color: white;">Tất cả</button>
            <button class="btn btn-light btn-sm rounded-pill px-3 text-muted fw-bold">Nội địa</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle" id="flightTable">
            <thead class="bg-light text-muted small text-uppercase" style="border-bottom: 2px solid #eee;">
                <tr>
                    <th class="py-3 border-0">Mã CB</th>
                    <th class="py-3 border-0">Tuyến bay</th>
                    <th class="py-3 border-0">Ngày giờ khởi hành</th>
                    <th class="py-3 border-0">Loại máy bay</th>
                    <th class="py-3 border-0">Trạng thái</th>
                    <th class="py-3 border-0 text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var flight in Model)
                    {
                        var from = flight.MaTuyenNavigation?.MaSbdiNavigation?.MaSb ?? "N/A";
                        var to = flight.MaTuyenNavigation?.MaSbdenNavigation?.MaSb ?? "N/A";
                        var airplane = flight.MaLoaiMbNavigation?.TenLoaiMb ?? "N/A";
                        
                        <tr id="row-@flight.MaCb">
                            <td class="fw-bold text-primary">@flight.MaCb</td>
                            <td class="fw-bold">@from <i class="bi bi-arrow-right mx-2 opacity-25"></i> @to</td>
                            <td>
                                <div class="fw-bold text-dark">@flight.NgayGioBay.ToString("dd/MM/yyyy")</div>
                                @if(flight.TrangThai == "Delay") 
                                {
                                    <div class="small text-danger">@flight.NgayGioBay.ToString("hh:mm tt") (Dự kiến)</div>
                                }
                                else 
                                {
                                    <div class="small text-muted">@flight.NgayGioBay.ToString("hh:mm tt")</div>
                                }
                            </td>
                            <td>@airplane</td>
                            <td>
                                @if (flight.TrangThai == "Đúng giờ")
                                {
                                    <span class="status-pill status-ontime" style="background: #d1fae5; color: #059669; padding: 6px 12px; border-radius: 50px; font-weight: bold; font-size: 12px;">Đúng giờ</span>
                                }
                                else if (flight.TrangThai == "Delay")
                                {
                                    <span class="status-pill status-delay" style="background: #fee2e2; color: #dc2626; padding: 6px 12px; border-radius: 50px; font-weight: bold; font-size: 12px;">Delay</span>
                                }
                                else
                                {
                                    <span class="status-pill" style="background: #f1f5f9; color: #475569; padding: 6px 12px; border-radius: 50px; font-weight: bold; font-size: 12px;">@(flight.TrangThai ?? "N/A")</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn-action btn-view" title="Xem" onclick="openViewModal('@flight.MaCb')" style="width: 32px; height: 32px; border-radius: 8px; border: none; background: #e0e7ff; color: #4f46e5; margin-left: 4px;"><i class="bi bi-eye"></i></button>
                                <button class="btn-action btn-edit" title="Sửa" onclick="openEditModal('@flight.MaCb')" style="width: 32px; height: 32px; border-radius: 8px; border: none; background: #fef08a; color: #d97706; margin-left: 4px;"><i class="bi bi-pencil-square"></i></button>
                                <button class="btn-action btn-delete" title="Xóa" onclick="openDeleteModal('@flight.MaCb')" style="width: 32px; height: 32px; border-radius: 8px; border: none; background: #fee2e2; color: #dc2626; margin-left: 4px;"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Chưa có dữ liệu chuyến bay.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="d-flex justify-content-between align-items-center mt-4 border-top pt-3">
        <div class="small text-muted fst-italic">Hiển thị 1 - @(Model?.Count() ?? 0) của @totalFlights chuyến bay</div>
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item disabled"><a class="page-link border-0 fw-bold text-muted rounded-3" href="#"><i class="bi bi-chevron-left"></i></a></li>
                <li class="page-item active"><a class="page-link border-0 text-white rounded-3 mx-1" style="background:#003580;" href="#">1</a></li>
                <li class="page-item"><a class="page-link border-0 text-muted fw-bold rounded-3 mx-1" href="#">2</a></li>
                <li class="page-item"><a class="page-link border-0 text-muted fw-bold rounded-3" href="#"><i class="bi bi-chevron-right"></i></a></li>
            </ul>
        </nav>
    </div>
</div>

<!-- Modal Thêm/Sửa Chuyến Bay -->
<div class="modal fade" id="modalFlight" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="fw-bold mb-0" id="modalFlightTitle" style="color: var(--primary-navy, #003580);"><i class="bi bi-airplane-engines me-2"></i>Thêm Chuyến bay mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="flightForm">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">MÃ CHUYẾN BAY</label>
                        <input type="text" class="form-control bg-light border-0 py-2 fw-bold" id="fCode" placeholder="VD: VN123" required>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">TUYẾN BAY</label>
                            <select class="form-select bg-light border-0 py-2 fw-bold">
                                <option>HAN - SGN</option>
                                <option>SGN - HAN</option>
                                <option>DAD - HAN</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">MÁY BAY</label>
                            <select class="form-select bg-light border-0 py-2 fw-bold">
                                <option>Airbus A321</option>
                                <option>Boeing 787</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">NGÀY KHỞI HÀNH</label>
                            <input type="date" class="form-control bg-light border-0 py-2" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">GIỜ KHỞI HÀNH</label>
                            <input type="time" class="form-control bg-light border-0 py-2" required>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">TRẠNG THÁI</label>
                        <select class="form-select bg-light border-0 py-2 fw-bold" id="fStatus">
                            <option value="ontime">Đúng giờ</option>
                            <option value="delay">Delay</option>
                            <option value="cancel">Hủy chuyến</option>
                        </select>
                    </div>
                    <button type="submit" class="btn w-100 rounded-pill py-3 fw-bold text-white shadow-sm" style="background: var(--primary-navy, #003580);" onclick="saveFlight(event)">LƯU THÔNG TIN</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xem Chi Tiết -->
<div class="modal fade" id="modalView" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: 20px; overflow: hidden;">
            <div class="modal-header border-0 text-white" style="background: linear-gradient(90deg, #00265c 0%, #003580 100%); padding: 20px 30px;">
                <div class="d-flex align-items-center">
                    <div class="bg-white bg-opacity-25 rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 45px; height: 45px;">
                        <i class="bi bi-airplane-fill fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0" id="viewCode">VN123</h4>
                        <div class="small opacity-75">Ngày bay: 15/06/2026</div>
                    </div>
                </div>
                <div class="text-end">
                    <span class="badge bg-success text-white px-3 py-2 rounded-pill fs-6 border border-white">ĐANG KHỞI HÀNH</span>
                </div>
            </div>

            <div class="modal-body bg-light p-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h6 class="fw-bold text-muted text-uppercase small mb-4"><i class="bi bi-clock-history me-2"></i>Chi tiết lịch trình (Scheduled vs Actual)</h6>
                    <div class="row position-relative">
                        <div class="position-absolute top-50 start-50 translate-middle w-50" style="height: 2px; border-top: 2px dashed #cbd5e1; z-index: 1;"></div>
                        <div class="col-5 text-center position-relative z-2 bg-white">
                            <h2 class="fw-bold text-navy mb-0">HAN</h2>
                            <div class="fw-bold mb-2">Hà Nội (Nội Bài)</div>
                            <div class="d-inline-block bg-light rounded-3 p-2 text-start small">
                                <div class="text-muted">Dự kiến: <span class="fw-bold text-dark">08:30 AM</span></div>
                                <div class="text-success">Thực tế: <span class="fw-bold">08:32 AM</span></div>
                            </div>
                        </div>
                        <div class="col-2 text-center position-relative z-2 bg-white d-flex flex-column justify-content-center">
                            <i class="bi bi-airplane fs-4 text-primary mb-1"></i>
                            <span class="badge bg-primary-subtle text-primary rounded-pill small">2h 15m</span>
                        </div>
                        <div class="col-5 text-center position-relative z-2 bg-white">
                            <h2 class="fw-bold text-navy mb-0">SGN</h2>
                            <div class="fw-bold mb-2">TP. Hồ Chí Minh</div>
                            <div class="d-inline-block bg-light rounded-3 p-2 text-start small">
                                <div class="text-muted">Dự kiến: <span class="fw-bold text-dark">10:45 AM</span></div>
                                <div class="text-primary">Ước tính: <span class="fw-bold">10:40 AM</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                            <h6 class="fw-bold text-muted text-uppercase small mb-3"><i class="bi bi-gear-fill me-2"></i>Kỹ thuật & Tải trọng</h6>
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Tàu bay:</span>
                                <span class="fw-bold text-dark">Airbus A321 <span class="text-primary">(VN-A589)</span></span>
                            </div>
                            <div class="mt-3">
                                <div class="d-flex justify-content-between mb-1 small">
                                    <span class="text-muted">Khách Thương gia (C):</span>
                                    <span class="fw-bold text-dark">15/16</span>
                                </div>
                                <div class="progress mb-2" style="height: 6px;">
                                    <div class="progress-bar bg-warning" style="width: 93%"></div>
                                </div>
                                <div class="d-flex justify-content-between mb-1 small">
                                    <span class="text-muted">Khách Phổ thông (Y):</span>
                                    <span class="fw-bold text-dark">170/194</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-primary" style="width: 87%"></div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between mt-3 pt-3 border-top small">
                                <span class="text-muted">Tổng hành lý ký gửi:</span>
                                <span class="fw-bold text-danger">3,250 kg</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 p-4 h-100" style="background: #e0e7ff;">
                            <h6 class="fw-bold text-navy text-uppercase small mb-3"><i class="bi bi-geo-alt-fill me-2"></i>Thông tin nhà ga</h6>
                            <div class="row g-3">
                                <div class="col-6">
                                    <div class="bg-white p-3 rounded-3 text-center shadow-sm">
                                        <div class="small text-muted mb-1">Cửa ra MB</div>
                                        <h3 class="fw-bold text-navy mb-0">08</h3>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-white p-3 rounded-3 text-center shadow-sm">
                                        <div class="small text-muted mb-1">Nhà ga (Terminal)</div>
                                        <h3 class="fw-bold text-navy mb-0">T1</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="bg-white p-2 rounded-3 mt-3 text-center small fw-bold text-muted shadow-sm">
                                Băng chuyền hành lý dự kiến: <span class="text-success fs-6">Số 04</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 p-4 bg-white justify-content-between">
                <button type="button" class="btn btn-outline-danger rounded-pill px-4 fw-bold small"><i class="bi bi-exclamation-triangle me-2"></i>Báo Delay</button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold small border"><i class="bi bi-printer me-2"></i>In Manifest</button>
                    <button type="button" class="btn rounded-pill px-4 fw-bold small text-white" style="background: var(--primary-navy, #003580);" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Delete -->
<div class="modal fade" id="modalDelete" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content shadow-lg text-center p-4" style="border-radius: 20px; border: none;">
            <i class="bi bi-exclamation-triangle-fill text-danger display-4 mb-3"></i>
            <h5 class="fw-bold mb-2">Xác nhận xóa?</h5>
            <p class="text-muted small mb-4">Bạn có chắc muốn xóa chuyến bay <strong id="delFlightCode" class="text-dark"></strong> không? Hành động này không thể hoàn tác.</p>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light w-50 rounded-pill fw-bold" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger w-50 rounded-pill fw-bold" onclick="confirmDelete()">Xóa bỏ</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Thông Báo -->
<div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 1060; margin-top: 20px;">
    <div id="liveToast" class="toast align-items-center text-white bg-success border-0 shadow-lg rounded-pill px-4 py-3" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-bold fs-6 p-0" id="toastMessage">
                Thao tác thành công!
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/admin/js/QuanLyChuyenBay.js" asp-append-version="true" defer></script>
}

