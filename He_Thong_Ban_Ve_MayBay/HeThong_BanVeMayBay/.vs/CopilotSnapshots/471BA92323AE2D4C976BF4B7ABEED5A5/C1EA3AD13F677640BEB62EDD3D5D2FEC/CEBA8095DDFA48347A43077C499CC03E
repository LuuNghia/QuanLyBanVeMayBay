@{
    ViewData["Title"] = "Sân bay & Tuyến bay - SkyBooking Admin";

    // Lay du lieu tu ViewBag
    var airports = ViewBag.Airports as IEnumerable<HeThong_BanVeMayBay.Models.Entities.SanBay>;
    var routes = ViewBag.Routes as IEnumerable<HeThong_BanVeMayBay.Models.Entities.TuyenBay>;

    // Dem so luong thong ke
    var activeRoutesCount = routes?.Count(r => r.TrangThai == true) ?? 0;
    var maintenanceRoutesCount = routes?.Count(r => r.TrangThai == false) ?? 0;
    var airportCount = airports?.Count() ?? 0;
}

@section Styles {
    <link href="~/admin/css/SanBayVaTuyenBay.css" rel="stylesheet" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-navy mb-1" style="color: var(--primary-navy);">Quản lý Hạ tầng bay</h3>
        <p class="text-muted small">Cấu hình danh sách Sân bay và mạng lưới Tuyến bay khai thác.</p>
    </div>
    <button id="dynamicAddBtn" class="btn text-white rounded-pill px-4 fw-bold shadow-sm" style="background: var(--primary-navy);" onclick="openAddModal()">
        <i class="bi bi-plus-lg me-2"></i>Thêm Sân bay mới
    </button>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4"><div class="card-stat"><div class="text-muted small fw-bold text-uppercase">Sân bay đối tác</div><h3 class="fw-bold mt-1">@airportCount <span class="fs-6 text-muted fw-normal">sân bay</span></h3></div></div>
    <div class="col-md-4"><div class="card-stat" style="border-color: #0ea5e9;"><div class="text-muted small fw-bold text-uppercase">Tuyến bay đang khai thác</div><h3 class="fw-bold mt-1">@activeRoutesCount <span class="fs-6 text-muted fw-normal">tuyến</span></h3></div></div>
    <div class="col-md-4"><div class="card-stat" style="border-color: #f59e0b;"><div class="text-muted small fw-bold text-uppercase">Tuyến bay bảo trì</div><h3 class="fw-bold mt-1 text-warning">@maintenanceRoutesCount <span class="fs-6 text-muted fw-normal">tuyến</span></h3></div></div>
</div>

<div class="custom-container">
    <ul class="nav nav-tabs mb-4" id="infraTab" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" id="airport-tab" data-bs-toggle="tab" data-bs-target="#airport-content" type="button" onclick="updateAddButton('airport')"><i class="bi bi-building me-2"></i>Danh sách Sân bay</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="route-tab" data-bs-toggle="tab" data-bs-target="#route-content" type="button" onclick="updateAddButton('route')"><i class="bi bi-geo-alt me-2"></i>Mạng lưới Tuyến bay</button>
        </li>
    </ul>

    <div class="tab-content">

        <div class="tab-pane fade show active" id="airport-content">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr><th>MÃ SÂN BAY</th><th>TÊN SÂN BAY</th><th>THÀNH PHỐ / QUỐC GIA</th><th class="text-end">THAO TÁC</th></tr>
                    </thead>
                    <tbody>
                        @if (airports != null && airports.Any())
                        {
                            foreach (var sb in airports)
                            {
                                <tr id="sb-@sb.MaSb">
                                    <td class="fw-bold text-primary">@sb.MaSb</td>
                                    <td class="fw-bold">@sb.TenSb</td>
                                    <td><i class="bi bi-geo-alt-fill text-danger me-1"></i> @sb.ThanhPho</td>
                                    <td class="text-end">
                                        <button class="btn-action" title="Sửa" onclick="openEditAirport('@sb.MaSb', '@sb.TenSb', '@sb.ThanhPho')"><i class="bi bi-pencil-square"></i></button>
                                        <button class="btn-action text-danger" title="Xóa" onclick="confirmDelete('Sân bay @sb.MaSb', 'sb-@sb.MaSb')"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center py-4">Chưa có dữ liệu sân bay.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="route-content">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>MÃ TUYẾN</th>
                            <th>SÂN BAY ĐI</th>
                            <th>SÂN BAY ĐẾN</th>
                            <th>KHOẢNG CÁCH</th>
                            <th>TG DỰ KIẾN</th>
                            <th>TRẠNG THÁI</th>
                            <th class="text-end">THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (routes != null && routes.Any())
                        {
                            foreach (var cb in routes)
                            {
                                var from = cb.MaSbdiNavigation?.TenSb ?? cb.MaSbdi ?? "N/A";
                                var to = cb.MaSbdenNavigation?.TenSb ?? cb.MaSbden ?? "N/A";

                                <tr id="tb-@cb.MaTuyen">
                                    <td class="fw-bold text-primary">@cb.MaTuyen</td>
                                    <td class="fw-bold text-primary">@from</td>
                                    <td class="fw-bold text-success">@to</td>
                                    <td>@cb.KhoangCach km</td>
                                    <td>@cb.ThoiGianBayDuKien phút</td>
                                    <td>
                                        <div class="form-check form-switch status-toggle">
                                            <input class="form-check-input" type="checkbox" @(cb.TrangThai == true ? "checked" : "") onchange="if(typeof toastMessage === 'function') toastMessage('Cập nhật trạng thái tuyến bay')">
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn-action" title="Sửa" onclick="openEditRoute('@cb.MaTuyen')"><i class="bi bi-pencil-square"></i></button>
                                        <button class="btn-action text-danger" title="Xóa" onclick="confirmDelete('Tuyến bay @cb.MaTuyen', 'tb-@cb.MaTuyen')"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center py-4">Chưa có dữ liệu tuyến bay.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <div class="small text-muted fst-italic">Hiển thị dữ liệu trang 1</div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item disabled"><a class="page-link" href="#"><i class="bi bi-chevron-left"></i></a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#"><i class="bi bi-chevron-right"></i></a></li>
                </ul>
            </nav>
        </div>

    </div>
</div>

<div class="modal fade" id="modalAirport" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="fw-bold mb-0 text-navy" id="titleAirport"><i class="bi bi-building me-2"></i>Thêm Sân bay mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="formAirport" onsubmit="submitForm(event, 'modalAirport')">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">MÃ SÂN BAY (3 KÝ TỰ)</label>
                        <input type="text" class="form-control bg-light border-0 py-2 fw-bold text-uppercase" id="sbMa" placeholder="VD: SGN, HAN..." maxlength="3" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">TÊN SÂN BAY</label>
                        <input type="text" class="form-control bg-light border-0 py-2" id="sbTen" placeholder="VD: Cảng hàng không Quốc tế Tân Sơn Nhất" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">THÀNH PHỐ / TỈNH</label>
                        <input type="text" class="form-control bg-light border-0 py-2" id="sbThanhPho" placeholder="VD: TP. Hồ Chí Minh" required>
                    </div>
                    <button type="submit" class="btn w-100 rounded-pill py-3 fw-bold text-white shadow-sm" style="background: var(--primary-navy);">LƯU THÔNG TIN</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalRoute" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="fw-bold mb-0 text-navy" id="titleRoute"><i class="bi bi-geo-alt me-2"></i>Thêm Tuyến bay mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="formRoute" onsubmit="submitForm(event, 'modalRoute')">
                    <input type="hidden" id="tbMaTuyenRoot" value="" />
                    <div class="row g-3 mb-3">
                        <div class="col-5">
                            <label class="form-label small fw-bold text-muted">ĐIỂM ĐI</label>
                            <select class="form-select bg-light border-0 py-2 fw-bold" id="tbDi" required>
                                <option value="">Chọn...</option>
                                @if (airports != null)
                                {
                                    foreach (var sb in airports)
                                    {
                                        <option value="@sb.MaSb">@sb.MaSb - @sb.TenSb</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-2 d-flex align-items-end justify-content-center pb-2">
                            <i class="bi bi-arrow-right fs-4 text-muted"></i>
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-bold text-muted">ĐIỂM ĐẾN</label>
                            <select class="form-select bg-light border-0 py-2 fw-bold" id="tbDen" required>
                                <option value="">Chọn...</option>
                                @if (airports != null)
                                {
                                    foreach (var sb in airports)
                                    {
                                        <option value="@sb.MaSb">@sb.MaSb - @sb.TenSb</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">KHOẢNG CÁCH (KM)</label>
                            <input type="number" class="form-control bg-light border-0 py-2" id="tbKhoangCach" placeholder="VD: 1190" required>
                        </div>
                        <div class="col-6" style="display:none;">
                            <label class="form-label small fw-bold text-muted">T/G BAY DỰ KIẾN (PHÚT)</label>
                            <input type="number" class="form-control bg-light border-0 py-2" id="tbThoiGianBay" placeholder="VD: 125" value="120">
                        </div>
                    </div>
                    <button type="submit" class="btn w-100 rounded-pill py-3 fw-bold text-white shadow-sm" style="background: var(--primary-navy);">LƯU TUYẾN BAY</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDelete" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content shadow-lg text-center p-4" style="border-radius: 20px;">
            <i class="bi bi-exclamation-triangle-fill text-danger display-4 mb-3"></i>
            <h5 class="fw-bold mb-2">Xác nhận xóa?</h5>
            <p class="text-muted small mb-4">Bạn có chắc muốn xóa <strong id="delName" class="text-dark"></strong> không? Thao tác không thể phục hồi.</p>
            <input type="hidden" id="delContextId" value="" />
            <input type="hidden" id="delContextType" value="" />
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light w-50 rounded-pill fw-bold" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger w-50 rounded-pill fw-bold" onclick="executeDelete()">Xóa bỏ</button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 1060; margin-top: 20px;">
    <div id="liveToast" class="toast align-items-center text-white bg-success border-0 shadow-lg rounded-pill px-4 py-3" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-bold fs-6 p-0" id="toastMessage">Thao tác thành công!</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/admin/js/SanBayVaTuyenBay.js" asp-append-version="true" defer></script>
}