    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --primary-navy: #003580;
            --navy-gradient: linear-gradient(90deg, #00265c 0%, #003580 100%);
            --secondary-gold: #feba02;
            --bg-light: #f4f6f9;
            /* Màu sắc các khoang */
            --bg-business: #fffbeb;
            --text-business: #d97706; /* Màu vàng/cam */

            --bg-premium: #f0fdf4;
            --text-premium: #0f766e; /* Màu xanh lá đậm / Xanh rêu */

            --bg-economy: #eff6ff;
            --text-economy: #0ea5e9; /* Màu xanh dương trong vắt */
        }

        body {
            font-family: 'Roboto', sans-serif;
            background-color: var(--bg-light);
            color: #333;
        }

        /* --- NAVBAR DÙNG CHUNG --- */
        .navbar {
            background-color: var(--primary-navy) !important;
            padding: 12px 0;
        }

        .navbar-brand {
            font-size: 22px;
            letter-spacing: 1px;
            color: white !important;
        }

        .nav-link {
            font-size: 15px;
            margin: 0 5px;
            transition: 0.3s;
            color: rgba(255,255,255,0.8) !important;
        }

            .nav-link:hover {
                color: var(--secondary-gold) !important;
            }

        .user-avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            border: 2px solid var(--secondary-gold);
            object-fit: cover;
        }

        .dropdown-menu {
            border: none;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            border-radius: 12px;
            padding: 10px;
        }

        .dropdown-item {
            border-radius: 8px;
            padding: 10px 15px;
        }

        /* --- KHUNG HEADER ĐIỀU HƯỚNG BƯỚC --- */
        .step-header {
            background: white;
            padding: 15px 0;
            border-bottom: 1px solid #e2e8f0;
            margin-bottom: 30px;
        }

            .step-header .back-btn {
                color: var(--primary-navy);
                font-weight: 700;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                transition: 0.2s;
            }

                .step-header .back-btn:hover {
                    transform: translateX(-5px);
                }

        /* CARD CHUNG */
        .card-custom {
            background: white;
            border-radius: 20px;
            padding: 30px;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.03);
            height: 100%;
        }

        /* --- CỘT TRÁI: SƠ ĐỒ --- */
        .title-main {
            color: var(--primary-navy);
            font-weight: 800;
            font-size: 24px;
            text-align: center;
            margin-bottom: 30px;
        }

        .cabin-box {
            border-radius: 16px;
            padding: 25px 15px;
            margin-bottom: 25px;
            text-align: center;
        }

        .cabin-title {
            font-size: 13px;
            font-weight: 800;
            text-transform: uppercase;
            margin-bottom: 25px;
            letter-spacing: 0.5px;
        }

        /* Phân loại màu nền khoang */
        .cabin-business {
            background-color: var(--bg-business);
            border: 1px solid #fef08a;
        }

            .cabin-business .cabin-title {
                color: var(--text-business);
            }

        .cabin-premium {
            background-color: var(--bg-premium);
            border: 1px solid #bbf7d0;
        }

            .cabin-premium .cabin-title {
                color: var(--text-premium);
            }

        .cabin-economy {
            background-color: var(--bg-economy);
            border: 1px solid #bfdbfe;
        }

            .cabin-economy .cabin-title {
                color: var(--text-economy);
            }

        /* Lưới ghế - Căn chỉnh vị trí */
        .seat-row {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            margin-bottom: 12px;
        }

        .seat-group {
            display: flex;
            gap: 8px;
            width: 130px;
        }

            .seat-group.left-window {
                justify-content: flex-start;
            }

            .seat-group.center-block {
                justify-content: center;
            }

            .seat-group.right-window {
                justify-content: flex-end;
            }

        .aisle-space {
            width: 25px;
            font-size: 11px;
            font-weight: bold;
            color: #cbd5e1;
            text-align: center;
        }

        /* Tùy chỉnh ô ghế */
        .seat {
            width: 38px;
            height: 42px;
            background-color: white;
            border: 2px solid #cbd5e1;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 800;
            color: #64748b;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .seat[data-type="business"] {
                border-color: var(--text-business);
                color: var(--text-business);
            }

            .seat[data-type="premium"] {
                border-color: var(--text-premium);
                color: var(--text-premium);
            }

            .seat[data-type="economy"] {
                border-color: var(--text-economy);
                color: var(--text-economy);
            }

            .seat:hover:not(.booked) {
                transform: translateY(-3px);
                box-shadow: 0 4px 10px rgba(0,0,0,0.1);
                background-color: #f8fafc;
            }

            .seat.selected[data-type="business"] {
                background-color: var(--text-business);
                color: white;
                transform: scale(1.1);
                box-shadow: 0 4px 15px rgba(217, 119, 6, 0.4);
            }

            .seat.selected[data-type="premium"] {
                background-color: var(--text-premium);
                color: white;
                transform: scale(1.1);
                box-shadow: 0 4px 15px rgba(15, 118, 110, 0.4);
            }

            .seat.selected[data-type="economy"] {
                background-color: var(--text-economy);
                color: white;
                transform: scale(1.1);
                box-shadow: 0 4px 15px rgba(14, 165, 233, 0.4);
            }

            .seat.booked {
                background-color: #e2e8f0;
                color: #94a3b8;
                border-color: #cbd5e1 !important;
                cursor: not-allowed;
                opacity: 0.6;
            }

        /* --- CỘT PHẢI: PANEL THÔNG TIN --- */
        .price-card {
            background-color: #f8fafc;
            border: 1px dashed #cbd5e1;
            border-radius: 16px;
            padding: 25px;
            text-align: center;
            margin-bottom: 25px;
            transition: 0.3s;
        }

            .price-card.active {
                background-color: #fffbeb;
                border: 1px solid #fde047;
                border-style: solid;
            }

        .section-title {
            font-size: 11px;
            font-weight: 800;
            color: #94a3b8;
            text-transform: uppercase;
            margin-bottom: 15px;
            letter-spacing: 0.5px;
        }

        .info-list {
            list-style: none;
            padding: 0;
            margin: 0 0 25px 0;
        }

            .info-list li {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 15px 20px;
                border: 1px solid #f1f5f9;
                border-radius: 12px;
                margin-bottom: 10px;
                font-size: 14px;
                background: #fafaf9;
            }

                .info-list li i {
                    color: var(--primary-navy);
                    font-size: 1.2rem;
                }

        /* Bill Summary */
        .bill-summary {
            background: var(--bg-light);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 25px;
            border: 1px solid #e2e8f0;
        }

        .bill-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 14px;
            color: #475569;
        }

            .bill-row:last-child {
                margin-bottom: 0;
                padding-top: 15px;
                border-top: 1px dashed #cbd5e1;
                font-weight: 800;
                color: var(--primary-navy);
                font-size: 18px;
            }

        .btn-checkout {
            background-color: var(--primary-navy);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 18px;
            width: 100%;
            font-weight: 700;
            font-size: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: 0.3s;
        }

            .btn-checkout:hover:not(:disabled) {
                background-color: #00265c;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0,53,128,0.2);
            }

            .btn-checkout:disabled {
                background-color: #cbd5e1;
                cursor: not-allowed;
            }
    </style>
</head>
