@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - User</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/user/css/User.css" />
    @RenderSection("Styles", required: false)
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark shadow sticky-top" style="background-color: var(--primary-navy, #003580);">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center" asp-area="User" asp-controller="Home" asp-action="Index">
                <i class="bi bi-airplane-engines-fill me-2" style="color: var(--secondary-gold, #feba02); font-size: 1.5rem;"></i>
                <span class="fw-bold fs-4" style="color: white; letter-spacing: 1px;">SkyBooking</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link text-white fw-medium px-3" asp-area="User" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link text-white fw-medium px-3" asp-area="User" asp-controller="Booking" asp-action="TraCuuVe">Tra cứu vé</a></li>
                    <li class="nav-item"><a class="nav-link text-white fw-medium px-3" asp-area="User" asp-controller="Booking" asp-action="LichSuDatVe">Lịch sử đặt vé</a></li>
                </ul>
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                            <span class="me-2 d-none d-lg-inline text-white">Nguyễn Văn A</span>
                            <img src="https://ui-avatars.com/api/?name=Nguyen+A&background=feba02&color=003580" class="rounded-circle border border-2 border-white shadow-sm" width="35" height="35" alt="User">
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                            <li><a class="dropdown-item" asp-area="User" asp-controller="Profile" asp-action="ThongTinCaNhan"><i class="bi bi-person me-2"></i>Thông tin cá nhân</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <main class="container mt-4 pb-5">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/user/js/User.js"></script>
    @RenderSection("Scripts", required: false)
</body>

</html>
