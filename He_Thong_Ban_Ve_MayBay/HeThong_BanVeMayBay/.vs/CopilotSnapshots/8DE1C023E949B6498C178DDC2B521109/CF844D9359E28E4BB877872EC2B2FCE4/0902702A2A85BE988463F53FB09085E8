@{
    ViewData["Title"] = "Sơ đồ ghế";
}

@section Styles {
    <link rel="stylesheet" href="~/admin/css/SoDoGhe.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h2 class="fw-bold text-navy mb-1" style="color: var(--primary-navy);">Cấu hình Sơ đồ Ghế</h2>
        <p class="text-muted small mb-0">Thiết kế vị trí, phân loại hạng ghế cho từng tàu bay.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card-custom d-flex justify-content-between align-items-center mb-4 p-3 bg-white rounded-4 shadow-sm">
            <div class="d-flex align-items-center">
                <div class="bg-primary-subtle rounded-4 d-flex justify-content-center align-items-center me-4" style="width: 60px; height: 60px;">
                    <i class="bi bi-airplane-fill fs-3" style="color: var(--primary-navy);"></i>
                </div>
                <div>
                    <div class="text-muted small mb-1 fw-bold text-uppercase">Đang hiệu chỉnh máy bay</div>
                    <h4 class="fw-bold mb-2" id="aircraftName" style="color: var(--primary-navy);">Boeing 787-9 Dreamliner</h4>
                    <span class="badge bg-primary-subtle text-primary me-2 px-3 py-2 rounded-pill">BUSINESS CLASS</span>
                    <span class="badge bg-light text-muted px-3 py-2 border rounded-pill" id="seatCountBadge">SỨC CHỨA: 290 GHẾ</span>
                </div>
            </div>
            <div class="dropdown">
                <button class="btn btn-light fw-bold px-4 py-2 border rounded-pill dropdown-toggle" data-bs-toggle="dropdown">Thay đổi</button>
                <ul class="dropdown-menu shadow-lg border-0 mt-2">
                    <li><a class="dropdown-item" href="#">Airbus A350-900</a></li>
                </ul>
            </div>
        </div>

        <div class="card-custom text-center py-5 position-relative bg-white rounded-4 shadow-sm">
            <div id="seatMapContainer">
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card-custom p-4 bg-white rounded-4 shadow-sm mb-4">
            <h6 class="fw-bold mb-4" style="color: var(--primary-navy);"><i class="bi bi-tag-fill me-2"></i>Thuộc tính Ghế</h6>
        </div>

        <div class="card-custom p-4 bg-white rounded-4 shadow-sm">
            <h6 class="fw-bold mb-3" style="color: var(--primary-navy);"><i class="bi bi-grid-1x2-fill me-2"></i>Thao tác hàng loạt</h6>
        </div>
    </div>
</div>

<div class="floating-action-bar">
    <button class="btn bg-white border fw-bold px-4 py-3 rounded-pill shadow-sm" onclick="undo()">Hoàn tác</button>
    <button class="btn text-white fw-bold px-5 py-3 rounded-pill shadow-lg ms-3" style="background: var(--primary-navy);" onclick="save()">Lưu cấu hình</button>
</div>

@section Scripts {
    <script src="~/admin/js/SoDoGhe.js" asp-append-version="true"></script>
}