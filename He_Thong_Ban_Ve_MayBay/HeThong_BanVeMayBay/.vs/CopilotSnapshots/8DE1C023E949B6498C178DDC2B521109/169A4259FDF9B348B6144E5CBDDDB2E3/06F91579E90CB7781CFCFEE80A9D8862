<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cấu hình Sơ đồ Ghế - SkyBooking Admin</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        /* ĐỒNG BỘ CSS BIẾN MÀU VỚI TOÀN HỆ THỐNG */
        :root {
            --primary-navy: #003580;
            --navy-gradient: linear-gradient(90deg, #00265c 0%, #003580 100%);
            --secondary-gold: #feba02;
            --sidebar-width: 280px;
            --bg-light: #f4f7fe;
            --glass-white: rgba(255, 255, 255, 0.1);
            --seat-gray: #cbd5e1;
        }

        body { font-family: 'Roboto', sans-serif; background-color: var(--bg-light); margin: 0; }

        /* --- SIDEBAR --- */
        #sidebar { width: var(--sidebar-width); height: 100vh; background-color: var(--primary-navy); position: fixed; left: 0; top: 0; z-index: 1001; padding: 20px 0; }
        .sidebar-brand { padding: 0 25px 30px; color: white; font-weight: 700; font-size: 22px; letter-spacing: 1px;}
        .nav-link { color: rgba(255,255,255,0.7); padding: 12px 25px; margin: 4px 15px; border-radius: 12px; transition: 0.3s; display: flex; align-items: center; text-decoration: none; }
        .nav-link i { font-size: 1.2rem; margin-right: 15px; width: 20px; text-align: center; }
        .nav-link:hover, .nav-link.active { color: white; background: rgba(255,255,255,0.1); }
        .nav-link.active { background: var(--secondary-gold) !important; color: var(--primary-navy) !important; font-weight: 600; }

        /* --- TOPBAR GRADIENT --- */
        .topbar { margin-left: var(--sidebar-width); background: var(--navy-gradient); padding: 15px 40px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1000; box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
        .search-box { background: var(--glass-white); border: 1px solid rgba(255,255,255,0.2); border-radius: 15px; padding: 8px 20px; width: 400px; backdrop-filter: blur(10px); display: flex; align-items: center;}
        .search-box input { background: transparent; border: none; color: white; outline: none; width: 100%; margin-left: 10px; }
        .search-box input::placeholder { color: rgba(255,255,255,0.5); }
        .avatar-ad { width: 42px; height: 42px; background: var(--secondary-gold); color: var(--primary-navy); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; border: 2px solid white; }

        /* --- MAIN CONTENT --- */
        .main-content { margin-left: var(--sidebar-width); padding: 30px 40px; padding-bottom: 100px; }
        .card-custom { background: white; border-radius: 20px; padding: 25px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.03); margin-bottom: 20px; }

        /* --- VẼ ICON GHẾ --- */
        .seat-wrapper { display: flex; flex-direction: column; align-items: center; cursor: pointer; position: relative; width: 36px; transition: transform 0.2s;}
        .seat-wrapper:hover { transform: translateY(-3px); }
        .seat-shape { width: 22px; height: 26px; border-left: 3.5px solid currentColor; border-bottom: 3.5px solid currentColor; border-radius: 0 0 0 6px; position: relative; margin-bottom: 5px; transition: 0.2s; }
        .seat-shape::after { content: ''; position: absolute; top: 2px; right: 2px; width: 6px; height: 6px; background: currentColor; border-radius: 50%; }
        .seat-label { font-size: 9px; font-weight: 700; color: currentColor; pointer-events: none;}

        /* Các trạng thái của ghế */
        .seat-vip { color: var(--secondary-gold); }
        .seat-available { color: var(--primary-navy); }
        .seat-booked { color: var(--seat-gray); opacity: 0.5; cursor: not-allowed; }
        .seat-booked:hover { transform: none; }
        
        /* Trạng thái đang chọn */
        .seat-wrapper.selected::before { content: ''; position: absolute; top: -6px; left: -6px; right: -6px; bottom: -2px; border: 2px solid var(--primary-navy); border-radius: 8px; background: rgba(0, 53, 128, 0.05); z-index: -1;}

        .aisle-number { width: 30px; text-align: center; font-size: 11px; font-weight: 700; color: #94a3b8; align-self: flex-end; padding-bottom: 15px; }

        /* --- NÚT BẤM THAO TÁC --- */
        .btn-bulk { background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 15px 10px; font-size: 11px; font-weight: 700; color: var(--primary-navy); display: flex; flex-direction: column; align-items: center; gap: 8px; transition: 0.2s; width: 100%;}
        .btn-bulk:hover { border-color: var(--primary-navy); background: #f8fafc; transform: translateY(-2px);}
        .btn-bulk i { font-size: 18px; pointer-events: none;}

        .floating-action-bar { position: fixed; bottom: 30px; right: 40px; z-index: 100; display: flex; gap: 15px; }
    </style>
</head>
<body>

    <div id="sidebar">
        <div class="sidebar-brand">
