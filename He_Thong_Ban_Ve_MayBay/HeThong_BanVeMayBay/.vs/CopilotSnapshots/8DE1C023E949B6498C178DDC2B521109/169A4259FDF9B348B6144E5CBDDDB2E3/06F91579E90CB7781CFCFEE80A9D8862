    <div class="floating-action-bar">
        <button class="btn bg-white border fw-bold px-4 py-3 rounded-pill shadow-sm d-flex align-items-center" style="color: var(--primary-navy);" onclick="toastDemo('Đã hoàn tác thay đổi cuối cùng!', 'bg-secondary')">
            <i class="bi bi-arrow-counterclockwise me-2 fs-5"></i> Hoàn tác
        </button>
        <button class="btn text-white fw-bold px-5 py-3 rounded-pill shadow-lg d-flex align-items-center" style="background: var(--primary-navy);" onclick="toastDemo('Lưu cấu hình sơ đồ ghế thành công!', 'bg-success')">
            <i class="bi bi-floppy-fill me-2 fs-5"></i> Lưu cấu hình
        </button>
    </div>

    <div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 1055; margin-top: 20px;">
        <div id="liveToast" class="toast align-items-center text-white bg-success border-0 shadow-lg rounded-pill px-3 py-2" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body fw-bold fs-6" id="toastMessage">Thao tác thành công!</div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const toastEl = document.getElementById('liveToast');
        const bsToast = new bootstrap.Toast(toastEl, { delay: 2500 });
        let currentSelectedSeat = document.querySelector('.seat-wrapper.selected');

        // Hàm gọi Toast
        function toastDemo(msg, colorClass = 'bg-success') {
            document.getElementById('toastMessage').innerText = msg;
            toastEl.className = `toast align-items-center text-white border-0 shadow-lg rounded-pill px-3 py-2 ${colorClass}`;
            bsToast.show();
        }

        // ĐỔI MÁY BAY
        function changeAircraft(name, seats) {
            document.getElementById('aircraftName').innerText = name;
            document.getElementById('seatCountBadge').innerText = `SỨC CHỨA: ${seats} GHẾ`;
            toastDemo(`Đã load sơ đồ của ${name}!`);
        }

        // Xử lý click Ghế
        function seatClickHandler(e) {
            const seat = e.currentTarget;
            if(seat.classList.contains('seat-booked')) {
                toastDemo('Ghế này đã được bán, không thể chỉnh sửa!', 'bg-danger');
                return;
            }
            if(currentSelectedSeat) currentSelectedSeat.classList.remove('selected');
            seat.classList.add('selected');
            currentSelectedSeat = seat;

            const seatName = seat.getAttribute('data-seat');
            document.getElementById('panelTitle').innerHTML = `<i class="bi bi-tag-fill me-2"></i>Thuộc tính Ghế ${seatName}`;
            
            if(seat.classList.contains('seat-vip')) {
                document.getElementById('seatType').value = 'business';
                document.getElementById('seatPrice').value = '500,000';
            } else {
                document.getElementById('seatType').value = 'standard';
                document.getElementById('seatPrice').value = '150,000';
            }
        }

        // Gắn sự kiện ban đầu
        document.querySelectorAll('.seat-wrapper').forEach(seat => {
            seat.addEventListener('click', seatClickHandler);
        });

        // Nút Cập nhật ghế
        function updateSeat() {
            if(!currentSelectedSeat) return;
            const type = document.getElementById('seatType').value;
            if(type === 'business') {
                currentSelectedSeat.classList.remove('seat-available');
                currentSelectedSeat.classList.add('seat-vip');
            } else {
                currentSelectedSeat.classList.remove('seat-vip');
                currentSelectedSeat.classList.add('seat-available');
            }
            toastDemo('Cập nhật thuộc tính ghế thành công!');
        }

        // Nút Xóa ghế
        function deleteSeat() {
            if(currentSelectedSeat) {
                currentSelectedSeat.style.visibility = 'hidden';
                currentSelectedSeat.classList.remove('selected');
                document.getElementById('panelTitle').innerHTML = `<i class="bi bi-tag-fill me-2"></i>Thuộc tính Ghế`;
                toastDemo('Đã xóa bỏ vị trí ghế này khỏi sơ đồ!', 'bg-danger');
                currentSelectedSeat = null;
            }
        }

        /* --- THAO TÁC HÀNG LOẠT --- */
        const container = document.getElementById('seatMapContainer');

        // Thêm 1 Hàng
        function bulkAddRow() {
            const rows = container.querySelectorAll('.row-seats');
            const lastRow = rows[rows.length - 1];
            const newRowNum = rows.length + 1;
            
            const newRow = lastRow.cloneNode(true);
            newRow.querySelectorAll('.seat-wrapper').forEach(wrapper => {
                const letter = wrapper.getAttribute('data-seat').replace(/[0-9]/g, '');
                wrapper.setAttribute('data-seat', newRowNum + letter);
                wrapper.querySelector('.seat-label').innerText = newRowNum + letter;
                
                wrapper.classList.remove('selected', 'seat-booked', 'seat-vip');
                wrapper.classList.add('seat-available');
                wrapper.style.visibility = 'visible';
                wrapper.addEventListener('click', seatClickHandler);
            });

            newRow.querySelectorAll('.aisle-number').forEach(aisle => {
                if(aisle.innerText.trim() !== '') aisle.innerText = newRowNum;
            });

            container.appendChild(newRow);
            toastDemo(`Đã tạo thêm Hàng ghế số ${newRowNum} thành công!`);
        }

        // Thêm 1 Ghế (Bên cạnh ghế đang chọn)
        function bulkAddSeat() {
            if(!currentSelectedSeat) {
                toastDemo('Vui lòng chọn 1 ghế làm vị trí tham chiếu!', 'bg-warning');
                return;
            }
            
            const newSeat = currentSelectedSeat.cloneNode(true);
            
            // Xóa các class không cần thiết, đưa về trạng thái trống
            newSeat.classList.remove('selected', 'seat-booked', 'seat-vip');
            newSeat.classList.add('seat-available');
            newSeat.style.visibility = 'visible';
            
            // Đặt tên tạm thời là dấu '+'
            const rowNum = currentSelectedSeat.querySelector('.seat-label').innerText.match(/\d+/)[0];
            newSeat.setAttribute('data-seat', rowNum + '+');
            newSeat.querySelector('.seat-label').innerText = '+';
            
            newSeat.addEventListener('click', seatClickHandler);
            
            // Chèn vào ngay sau ghế đang chọn
            currentSelectedSeat.parentNode.insertBefore(newSeat, currentSelectedSeat.nextSibling);
            toastDemo('Đã chèn thêm 1 ghế mới vào sơ đồ!');
        }

        // Chia lối đi
        function bulkSplitAisle() {
            if(!currentSelectedSeat) {
                toastDemo('Vui lòng chọn 1 ghế để tạo lối đi bên cạnh!', 'bg-warning');
                return;
            }
            const aisle = document.createElement('div');
            aisle.className = 'aisle-number';
            aisle.style.width = '30px';
            currentSelectedSeat.parentNode.insertBefore(aisle, currentSelectedSeat.nextSibling);
            toastDemo('Đã chèn lối đi vào sơ đồ thành công!');
        }

        // Auto Layout
        function bulkAutoLayout() {
            const rows = container.querySelectorAll('.row-seats');
            rows.forEach(row => {
                row.style.opacity = '0';
                setTimeout(() => {
                    row.style.transition = 'opacity 0.5s ease';
                    row.style.opacity = '1';
                }, 300);
            });
            toastDemo('Đã tự động căn chỉnh lại toàn bộ khoảng cách!');
        }

        // Sao chép hàng
        function bulkCopyRow() {
            if(!currentSelectedSeat) {
                toastDemo('Vui lòng chọn 1 ghế trong hàng muốn sao chép!', 'bg-warning');
                return;
            }
            const currentRow = currentSelectedSeat.closest('.row-seats');
            const newRow = currentRow.cloneNode(true);
            
            newRow.querySelectorAll('.seat-wrapper').forEach(wrapper => {
                wrapper.classList.remove('selected');
                wrapper.addEventListener('click', seatClickHandler);
            });

            currentRow.parentNode.insertBefore(newRow, currentRow.nextSibling);
            toastDemo('Đã nhân bản hàng ghế vừa chọn!');
        }
    </script> 
</body>
</html>