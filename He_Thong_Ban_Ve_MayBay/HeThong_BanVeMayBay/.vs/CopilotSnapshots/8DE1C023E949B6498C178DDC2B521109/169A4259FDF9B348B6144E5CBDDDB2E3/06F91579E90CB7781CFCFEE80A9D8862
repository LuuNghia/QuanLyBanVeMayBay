            <a href="../Admin/CauHinhHeThong.html" class="nav-link"><i class="bi bi-gear-fill"></i> Cấu hình hệ thống</a>
        </nav>
    </div>

    <div class="topbar">
        <div class="search-box">
            <i class="bi bi-search text-white opacity-50"></i>
            <input type="text" placeholder="Tìm kiếm sơ đồ máy bay...">
        </div>
        <div class="d-flex align-items-center text-white">
            <i class="bi bi-bell-fill fs-5 me-4 cursor-pointer"></i>
            <div class="d-flex align-items-center">
                <div class="text-end me-3">
