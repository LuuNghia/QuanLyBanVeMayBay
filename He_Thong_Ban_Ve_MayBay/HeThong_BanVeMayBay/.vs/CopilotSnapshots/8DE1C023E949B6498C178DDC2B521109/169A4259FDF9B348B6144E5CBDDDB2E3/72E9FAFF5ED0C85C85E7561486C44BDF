<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tra Cứu Vé - SkyBooking</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --primary-navy: #003580;
            --secondary-gold: #feba02;
            --bg-light: #f4f6f9;
        }

        body {
            font-family: 'Roboto', sans-serif;
            background-color: var(--bg-light);
            color: #333;
            margin: 0;
            padding: 0;
        }

        /* --- NAVBAR (Đồng bộ Index) --- */
        .navbar {
            background-color: var(--primary-navy) !important;
            padding: 12px 0;
            border: none;
        }

        .navbar-brand {
            font-size: 22px;
            letter-spacing: 1px;
            color: white !important;
            display: flex;
            align-items: center;
        }

        .nav-link {
            font-size: 15px;
            margin: 0 5px;
            transition: 0.3s;
            color: rgba(255,255,255,0.7) !important;
        }

            .nav-link:hover, .nav-link.active {
                color: var(--secondary-gold) !important;
            }

        .user-avatar-circle {
            width: 35px;
            height: 35px;
            background-color: var(--secondary-gold);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: var(--primary-navy);
            font-size: 14px;
            margin-left: 10px;
        }

        /* --- LOOKUP BOX --- */
        .lookup-hero {
            background: var(--primary-navy);
            padding: 60px 0 100px 0;
            color: white;
            text-align: center;
        }

        .lookup-card {
            background: white;
            border-radius: 20px;
            padding: 40px;
            margin-top: -60px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            border: none;
        }

        .btn-lookup {
            background-color: var(--secondary-gold);
            color: var(--primary-navy);
            font-weight: 800;
            border: none;
            border-radius: 10px;
            padding: 12px;
            transition: 0.3s;
        }

            .btn-lookup:hover {
                background-color: #eab308;
                transform: translateY(-2px);
            }

        /* --- RESULT CARD --- */
        #search-result {
            display: none;
            margin-top: 30px;
        }

        .ticket-result-card {
            background: white;
            border-radius: 20px;
            border: 2px dashed #cbd5e1;
            padding: 30px;
            position: relative;
        }

            .ticket-result-card::before, .ticket-result-card::after {
                content: "";
                position: absolute;
                width: 30px;
                height: 30px;
                background: var(--bg-light);
                border-radius: 50%;
                top: 50%;
                transform: translateY(-50%);
            }

            .ticket-result-card::before {
                left: -17px;
            }

            .ticket-result-card::after {
                right: -17px;
            }

        .airport-code {
            font-size: 32px;
            font-weight: 900;
            color: var(--primary-navy);
        }

        .status-badge {
            padding: 5px 15px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 700;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark shadow sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#"><i class="bi bi-airplane-engines me-2"></i>SKYBOOKING</a>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link" href="#">Vé máy bay</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Lịch sử đặt vé</a></li>
                    <li class="nav-item"><a class="nav-link active" href="#">Tra cứu vé</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Hỗ trợ</a></li>
                </ul>
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item dropdown">
                        <a class="nav-link d-flex align-items-center text-white" href="#">
                            <span class="me-1">Nguyễn Văn A</span>
                            <div class="user-avatar-circle">NA</div>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="lookup-hero">
        <div class="container">
            <h2 class="fw-bold">Tra Cứu Thông Tin Chuyến Bay</h2>
            <p class="opacity-75">Nhập mã vé để kiểm tra hành trình và trạng thái thanh toán của bạn</p>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="lookup-card">
                    <form id="lookupForm" onsubmit="handleLookup(event)">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">MÃ VÉ (VD: SB12345)</label>
                                <input type="text" class="form-control text-uppercase" id="lookupMaVe" placeholder="Nhập mã vé của bạn" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">SỐ ĐIỆN THOẠI / EMAIL</label>
                                <input type="text" class="form-control" id="lookupContact" placeholder="Nhập thông tin liên hệ" required>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-lookup w-100">
                                    <i class="bi bi-search me-2"></i>TÌM KIẾM THÔNG TIN VÉ
                                </button>
                            </div>
                        </div>
                    </form>

                    <div id="search-result">
                        <hr class="my-5">
                        <div class="ticket-result-card">
                            <div class="d-flex justify-content-between align-items-start mb-4">
                                <div>
                                    <span class="badge bg-success-subtle text-success status-badge mb-2">ĐÃ THANH TOÁN</span>
                                    <h4 class="fw-bold text-navy mb-0">VN123 - Airbus A321</h4>
                                </div>
                                <div class="text-end">
                                    <div class="small text-muted">Mã vé (MaVe)</div>
                                    <div class="fw-bold text-primary fs-5">SB882910</div>
                                </div>
                            </div>

                            <div class="row align-items-center text-center mb-4">
                                <div class="col-4">
                                    <div class="airport-code">SGN</div>
                                    <div class="small fw-bold">Hồ Chí Minh</div>
                                    <div class="small text-muted">07/04/2026 • 20:30</div>
                                </div>
                                <div class="col-4">
                                    <div class="small text-muted mb-2">Trực tiếp</div>
                                    <i class="bi bi-airplane-fill fs-3 text-secondary"></i>
                                    <div class="small text-muted mt-2">2h 10m</div>
                                </div>
                                <div class="col-4">
                                    <div class="airport-code">HAN</div>
                                    <div class="small fw-bold">Hà Nội</div>
                                    <div class="small text-muted">07/04/2026 • 22:40</div>
                                </div>
                            </div>

                            <div class="bg-light p-3 rounded-3">
                                <div class="row text-center">
                                    <div class="col-4 border-end">
                                        <div class="small text-muted">Hành khách</div>
                                        <div class="fw-bold">NGUYỄN VĂN A</div>
                                    </div>
                                    <div class="col-4 border-end">
                                        <div class="small text-muted">Số ghế</div>
                                        <div class="fw-bold">12A (Thương gia)</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="small text-muted">Hành lý</div>
                                        <div class="fw-bold">12kg + 32kg</div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-4">
                                <button class="btn btn-primary w-100 fw-bold py-2"><i class="bi bi-download me-2"></i>Tải vé PDF</button>
                                <button class="btn btn-outline-navy w-100 fw-bold py-2"><i class="bi bi-printer me-2"></i>In vé</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function handleLookup(e) {
            e.preventDefault();
            // Giả lập hiệu ứng tìm kiếm
            const btn = e.target.querySelector('button');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang tìm kiếm...';
            btn.disabled = true;

            setTimeout(() => {
                document.getElementById('search-result').style.display = 'block';
                btn.innerHTML = originalText;
                btn.disabled = false;
                window.scrollTo({ top: document.getElementById('search-result').offsetTop - 100, behavior: 'smooth' });
            }, 1000);
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>