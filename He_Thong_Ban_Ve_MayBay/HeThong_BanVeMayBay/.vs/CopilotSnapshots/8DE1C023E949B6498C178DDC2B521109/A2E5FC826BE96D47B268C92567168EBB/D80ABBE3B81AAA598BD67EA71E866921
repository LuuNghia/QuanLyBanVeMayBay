@using System
@using HeThong_BanVeMayBay
@using HeThong_BanVeMayBay.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;

    string ActiveClass(string area, string controller, string action = null)
    {
        var rd = ViewContext.RouteData;
        var ra = (rd.Values["area"] ?? "").ToString();
        var rc = (rd.Values["controller"] ?? "").ToString();
        var raAction = (rd.Values["action"] ?? "").ToString();

        if (!string.IsNullOrEmpty(area) && !string.Equals(ra, area, StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }
        if (!string.IsNullOrEmpty(controller) && !string.Equals(rc, controller, StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }
        if (!string.IsNullOrEmpty(action) && !string.Equals(raAction, action, StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }
        return "active";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/admin/css/admin.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div id="sidebar">
        <div class="sidebar-brand px-3">SkyBooking Admin</div>
        <nav class="mt-3">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="nav-link @(ActiveClass("Admin","Home","Index"))"><i class="bi bi-house-fill"></i> Dashboard</a>

            <a asp-area="Admin" asp-controller="Flight" asp-action="SanBayVaTuyenBay" class="nav-link @(ActiveClass("Admin","Flight","SanBayVaTuyenBay"))">
                <i class="bi bi-geo-alt-fill"></i> Sân bay & Tuyến bay
            </a>

            <a asp-area="Admin" asp-controller="Flight" asp-action="Index"
               class="nav-link @(ActiveClass("Admin","Flight","Index"))">
                <i class="bi bi-airplane-fill"></i> Quản lý Chuyến bay
            </a>

            <a asp-area="Admin" asp-controller="Flight" asp-action="SeatMap" class="nav-link @(ActiveClass("Admin","Flight","SeatMap"))">
                <i class="bi bi-grid-3x3-gap"></i> Máy bay & Sơ đồ ghế
            </a>

            <a asp-area="Admin" asp-controller="Booking" asp-action="Index" class="nav-link @(ActiveClass("Admin","Booking","Index"))">
                <i class="bi bi-ticket-perforated-fill"></i> Quản lý Đặt vé
            </a>

            <a asp-area="Admin" asp-controller="Account" asp-action="Users" class="nav-link @(ActiveClass("Admin","Account","Users"))">
                <i class="bi bi-people-fill"></i> Nhân viên & Khách hàng
            </a>

            <a asp-area="Admin" asp-controller="Flight" asp-action="CauHinhHeThong" class="nav-link @(ActiveClass("Admin","Flight","CauHinhHeThong"))">
                <i class="bi bi-gear-fill"></i> Cấu hình hệ thống
            </a>
        </nav>
        <div style="position: absolute; bottom: 20px; width: 100%;">
            <a href="/Account/Logout" class="nav-link text-danger">
                <i class="bi bi-box-arrow-left"></i> Đăng xuất
            </a>
        </div>
    </div>

    <div class="topbar">
        <div class="search-box d-flex align-items-center">
            <i class="bi bi-search text-white opacity-50 me-2"></i>
            <input type="text" placeholder="Tìm kiếm...">
        </div>
        <div class="d-flex align-items-center text-white">
            <i class="bi bi-bell-fill me-4 fs-5 cursor-pointer"></i>
            <i class="bi bi-question-circle me-4 fs-5 cursor-pointer"></i>
            <div class="d-flex align-items-center">
                <div class="text-end me-3">
                    <div class="fw-bold small">Người quản trị</div>
                    <div class="opacity-75 small">Quản trị viên</div>
                </div>
                <div class="avatar-ad shadow-sm">AD</div>
            </div>
        </div>
    </div>

    <div class="main-content">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/admin/js/Dashboad.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>