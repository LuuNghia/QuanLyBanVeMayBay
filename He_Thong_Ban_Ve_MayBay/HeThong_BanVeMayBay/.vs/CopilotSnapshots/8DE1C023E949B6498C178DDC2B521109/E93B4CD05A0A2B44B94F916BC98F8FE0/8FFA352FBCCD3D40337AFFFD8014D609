<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - SkyBooking Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/admin/css/admin.css" asp-append-version="true">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div id="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-airplane-engines-fill me-2 text-warning"></i>SkyBooking
            <div style="font-size: 10px; opacity: 0.6; letter-spacing: 1px; margin-top: 5px;">HỆ THỐNG QUẢN TRỊ</div>
        </div>

        <nav class="nav flex-column">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index"
               class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                <i class="bi bi-grid-fill"></i> Tổng quan
            </a>

            <a asp-area="Admin" asp-controller="Flight" asp-action="Airports"
               class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Airports" ? "active" : "")">
                <i class="bi bi-geo-alt-fill"></i> Sân bay & Tuyến bay
            </a>

            <a asp-area="Admin" asp-controller="Flight" asp-action="Index"
               class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Flight" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                <i class="bi bi-airplane-fill"></i> Quản lý Chuyến bay
            </a>

            <a asp-area="Admin" asp-controller="Flight" asp-action="SeatMap" class="nav-link">
                <i class="bi bi-grid-3x3-gap"></i> Máy bay & Sơ đồ ghế
            </a>

            <a asp-area="Admin" asp-controller="Booking" asp-action="Index" class="nav-link">
                <i class="bi bi-ticket-perforated-fill"></i> Quản lý Đặt vé
            </a>

            <a asp-area="Admin" asp-controller="Account" asp-action="Users" class="nav-link">
                <i class="bi bi-people-fill"></i> Nhân viên & Khách hàng
            </a>

            <a asp-area="Admin" asp-controller="Home" asp-action="Settings" class="nav-link">
                <i class="bi bi-gear-fill"></i> Cấu hình hệ thống
            </a>
        </nav>

        <div style="position: absolute; bottom: 20px; width: 100%;">
            <a href="/Account/Logout" class="nav-link text-danger">
                <i class="bi bi-box-arrow-left"></i> Đăng xuất
            </a>
        </div>
    </div>

    <div class="topbar">
        <div class="search-box d-flex align-items-center">
            <i class="bi bi-search text-white opacity-50 me-2"></i>
            <input type="text" placeholder="Tìm kiếm chuyến bay, mã vé...">
        </div>

        <div class="d-flex align-items-center text-white">
            <div class="position-relative me-4 cursor-pointer">
                <i class="bi bi-bell-fill fs-5"></i>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                    3
                </span>
            </div>

            <div class="d-flex align-items-center border-start ps-4">
                <div class="text-end me-3">
                    <div class="fw-bold small">Nguyễn Admin</div>
                    <div class="opacity-75 small" style="font-size: 11px;">Quản trị viên tối cao</div>
                </div>
                <div class="avatar-ad shadow-sm">AD</div>
            </div>
        </div>
    </div>

    <div class="main-content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
    @section Scripts {
        <script src="~/admin/js/dashboard-charts.js" asp-append-version="true"></script>
    }

</body>
</html>