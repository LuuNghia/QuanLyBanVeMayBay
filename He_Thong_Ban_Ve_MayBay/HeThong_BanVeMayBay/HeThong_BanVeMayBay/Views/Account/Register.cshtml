@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký - SkyViet Airlines</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/account.css">
</head>
<body>
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>

    <div class="login-container register-container">
        <div class="login-card">
            <div class="brand-logo">
                <i class="bi bi-airplane-fill"></i>
                <div class="brand-name">SkyViet Airlines</div>
                <p class="text-muted small mt-2">Tạo tài khoản mới để bắt đầu hành trình</p>
            </div>

            <form id="registerForm">
                <div class="row">
                    <div class="col-md-12">
                        <label class="form-label">Họ và tên</label>
                        <div class="input-group-custom">
                            <input type="text" id="fullName" class="form-control-custom" placeholder="Nhập họ tên đầy đủ" required
                                   oninvalid="this.setCustomValidity('Vui lòng nhập ít nhất 2 từ (Họ và Tên)')" 
                                   oninput="this.setCustomValidity('')">
                            <i class="bi bi-person-badge"></i>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tên đăng nhập</label>
                        <div class="input-group-custom">
                            <input type="text" id="username" class="form-control-custom" placeholder="Tên tài khoản" required minlength="5"
                                   oninvalid="this.setCustomValidity('Tên đăng nhập phải có ít nhất 5 ký tự')" 
                                   oninput="this.setCustomValidity('')">
                            <i class="bi bi-person"></i>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Mật khẩu</label>
                        <div class="input-group-custom">
                            <input type="password" id="password" class="form-control-custom" placeholder="Mật khẩu" required minlength="6"
                                   oninvalid="this.setCustomValidity('Mật khẩu phải có ít nhất 6 ký tự')" 
                                   oninput="this.setCustomValidity('')">
                            <i class="bi bi-lock"></i>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Email</label>
                        <div class="input-group-custom">
                            <input type="email" id="email" class="form-control-custom" placeholder="example@gmail.com" required
                                   pattern=".*@@gmail\.com$"
                                   oninvalid="this.setCustomValidity('Email phải có đuôi @@gmail.com')" 
                                   oninput="this.setCustomValidity('')">
                            <i class="bi bi-envelope"></i>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Số điện thoại</label>
                        <div class="input-group-custom">
                            <input type="tel" id="phone" class="form-control-custom" placeholder="Nhập số điện thoại" required
                                   pattern="0[0-9]{9}"
                                   oninvalid="this.setCustomValidity('Số điện thoại phải bắt đầu bằng số 0 và có đúng 10 chữ số')" 
                                   oninput="this.setCustomValidity('')">
                            <i class="bi bi-phone"></i>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">CCCD / Passport</label>
                        <div class="input-group-custom">
                            <input type="text" id="cccd" class="form-control-custom" placeholder="Nhập số định danh" required
                                   pattern="[0-9]{9}|[0-9]{12}"
                                   oninvalid="this.setCustomValidity('CCCD phải là 9 hoặc 12 chữ số')" 
                                   oninput="this.setCustomValidity('')">
                            <i class="bi bi-card-text"></i>
                        </div>
                    </div>
                </div>

                <div class="form-check mb-3 mt-2">
                    <input class="form-check-input" type="checkbox" id="terms" required>
                    <label class="form-check-label small text-muted" for="terms">
                        Tôi đồng ý với <a href="#" class="text-primary fw-bold">Điều khoản & Chính sách</a> của SkyViet
                    </label>
                </div>

                <button type="submit" class="btn btn-primary-custom" id="btnRegister">
                    ĐĂNG KÝ NGAY
                </button>
            </form>

            <div class="divider">HOẶC</div>

            <div class="link-box">
                Bạn đã có tài khoản? <a href="/Account/Login">Đăng nhập ngay</a>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/account.js"></script>
</body>
</html>
