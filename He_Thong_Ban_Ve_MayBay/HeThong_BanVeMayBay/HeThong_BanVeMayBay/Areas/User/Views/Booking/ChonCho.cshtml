@{
    ViewData["Title"] = "Chọn chổ ngồi";
}
<link rel="stylesheet" type="text/css" href="~/user/css/ChonCho.css" />

<div class="step-header">
    <div class="container d-flex justify-content-between align-items-center">
        <a asp-area="User" asp-controller="Home" asp-action="Index" class="back-btn" onclick="history.back()"><i class="bi bi-arrow-left me-2"></i>Quay lại danh sách chuyến bay</a>
        <div class="small fw-bold text-muted text-uppercase">BƯỚC 2/4: CHỌN CHỖ NGỒI</div>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4">

        <div class="col-lg-7 col-xl-8">
            <div class="card-custom">
                <h3 class="title-main">Sơ đồ máy bay (@(ViewBag.ChuyenBay?.MaLoaiMbNavigation?.TenLoaiMb ?? "Máy bay"))</h3>
                
                @if (ViewBag.DanhSachGhe != null && ViewBag.DanhSachGhe.Count > 0)
                {
                    <div id="seatMapContainer" class="d-flex flex-column align-items-center flex-grow-1 overflow-auto px-2 mt-4">
                        @{
                            var danhSachGhe = ViewBag.DanhSachGhe as List<HeThong_BanVeMayBay.Models.Entities.Ghe>;
                            var maxHang = danhSachGhe.Max(g => g.ViTriHang) ?? 0;
                            var maxCot = danhSachGhe.Max(g => g.ViTriCot) ?? 0;
                            
                            var gheDaDat = ViewBag.GheDaDat as List<int?> ?? new List<int?>();

                            // Bổ sung Header Cột (A B C   D E F ...)
                            if (maxCot > 0) {
                                var colLabels = new[] { "A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L" };
                                int mid = maxCot / 2;
                                
                                <div class="d-flex justify-content-center align-items-center mb-4 text-muted fw-bold" style="font-size: 14px; padding-right: 0px;">
                                    <div class="d-flex justify-content-end" style="width: @(mid * 48)px; gap: 8px;">
                                        @for (int i = 0; i < mid; i++) {
                                            <div style="width: 40px;" class="text-center">@colLabels[i]</div>
                                        }
                                    </div>
                                    <div style="width: 40px;"></div> @* Khoảng trống cho cột số hàng *@
                                    <div class="d-flex justify-content-start" style="width: @((maxCot - mid) * 48)px; gap: 8px;">
                                        @for (int i = mid; i < maxCot; i++) {
                                            <div style="width: 40px;" class="text-center">@colLabels[i]</div>
                                        }
                                    </div>
                                </div>
                            }
                            
                            var danhSachHangGhe = danhSachGhe.GroupBy(g => g.MaHangGhe).Select(group => group.First().MaHangGheNavigation).ToList();
                            
                            foreach (var hg in danhSachHangGhe)
                            {
                                if (hg == null) continue;
                                
                                var gheCuaHang = danhSachGhe.Where(g => g.MaHangGhe == hg.MaHangGhe).ToList();
                                if (!gheCuaHang.Any()) continue;
                                
                                var color = hg.MauSac ?? "#ccc";
                                
                                <div class="p-4 mb-4 rounded-4 w-100 shadow-sm" style="border: 1px solid @(color)4d; background-color: @(color)08;">
                                    <h6 class="text-center fw-bold mb-4 text-uppercase" style="color: @color; letter-spacing: 2px;">
                                        <i class="bi bi-star-fill me-2"></i> @hg.TenHangGhe
                                    </h6>
                                    
                                    @{
                                        var rowsTrongHang = gheCuaHang.Select(g => g.ViTriHang).Distinct().OrderBy(h => h).ToList();
                                        if (maxCot > 0 && rowsTrongHang.Any(r => r > 0))
                                        {
                                            foreach (var r in rowsTrongHang)
                                            {
                                                var seatsInRow = gheCuaHang.Where(g => g.ViTriHang == r).OrderBy(g => g.ViTriCot).ToList();

                                                <div class="seat-row w-100 d-flex justify-content-center mb-3" style="gap: 8px;">
                                                    @for (int j = 1; j <= maxCot; j++)
                                                    {
                                                        var ghe = seatsInRow.FirstOrDefault(g => g.ViTriCot == j);

                                                        if (j == (maxCot / 2) + 1)
                                                        {
                                                            <div class="aisle-number text-center" style="width: 40px; display: flex; justify-content: center; align-items: center; background: #f8fafc; border-radius: 4px; font-size: 12px; color: #94a3b8; font-weight: bold;">
                                                                @r
                                                            </div>
                                                        }

                                                        if (ghe != null)
                                                        {
                                                            var isBooked = gheDaDat.Contains(ghe.MaGhe);
                                                            var price = ghe.PhuThu ?? 0;
                                                            var className = isBooked ? "seat booked" : (ghe.TrangThai == false ? "seat maintenance" : "seat available");
                                                            var colLabels = new[] { "A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L" };
                                                            var displayLabel = r + colLabels[j - 1];
                                                            
                                                            <div class="@className d-flex justify-content-center align-items-center" 
                                                                 style="width: 40px; height: 42px; border-radius: 8px; border: 2px solid @(isBooked || ghe.TrangThai == false ? "#e2e8f0" : color); cursor: @(isBooked || ghe.TrangThai == false ? "not-allowed" : "pointer"); font-weight: 800; font-size: 13px; position: relative; transition: 0.2s;"
                                                                 data-seat-id="@ghe.MaGhe" 
                                                                 data-seat-no="@displayLabel" 
                                                                 data-color="@color"
                                                                 data-class-name="@(hg.TenHangGhe)"
                                                                 data-price="@price"
                                                                 data-coefficient="@(hg.HeSoGia ?? 1.0)"
                                                                 data-amenities="@(string.Join(", ", hg.MaTienIches?.Select(t => t.TenTienIch).Where(t => t != null) ?? new List<string>()))"
                                                                 data-carryon="@(hg.HanhLyXachTay)"
                                                                 data-checked="@(hg.HanhLyKyGui)">
                                                                <span style="color: @(isBooked || ghe.TrangThai == false ? "#94a3b8" : color);">@displayLabel</span>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="empty-space" style="width: 40px; height: 42px;"></div>
                                                        }
                                                    }
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            @* Fallback: Render as a simple list if positions are not set *@
                                            <div class="d-flex flex-wrap justify-content-center gap-3">
                                                @foreach (var ghe in gheCuaHang)
                                                {
                                                    var isBooked = gheDaDat.Contains(ghe.MaGhe);
                                                    var price = ghe.PhuThu ?? 0;
                                                    var className = isBooked ? "seat booked" : (ghe.TrangThai == false ? "seat maintenance" : "seat available");

                                                    <div class="@className d-flex justify-content-center align-items-center"
                                                         style="width: 45px; height: 45px; border-radius: 10px; border: 2px solid @(isBooked || ghe.TrangThai == false ? "#e2e8f0" : color); cursor: @(isBooked || ghe.TrangThai == false ? "not-allowed" : "pointer"); font-weight: 800; font-size: 13px;"
                                                         data-seat-id="@ghe.MaGhe"
                                                         data-seat-no="@ghe.SoGhe"
                                                         data-color="@color"
                                                         data-class-name="@(hg.TenHangGhe)"
                                                         data-price="@price"
                                                         data-coefficient="@(hg.HeSoGia ?? 1.0)"
                                                         data-amenities="@(string.Join(", ", hg.MaTienIches?.Select(t => t.TenTienIch).Where(t => t != null) ?? new List<string>()))"
                                                         data-carryon="@(hg.HanhLyXachTay)"
                                                         data-checked="@(hg.HanhLyKyGui)">
                                                        <span style="color: @(isBooked || ghe.TrangThai == false ? "#94a3b8" : color);">@ghe.SoGhe</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted text-center my-5">
                        <i class="bi bi-grid-3x3-gap display-1 opacity-25"></i><br>Sơ đồ máy bay chưa được cấu hình.
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-5 col-xl-4">
            <div class="card-custom position-sticky" style="top: 100px;">
                <div class="text-center mb-4">
                    <h4 class="fw-bold" style="color: var(--primary-navy);">Chuyến bay @(ViewBag.ChuyenBay?.MaCb)</h4>
                    <div class="text-muted small mt-1">
                        @(ViewBag.ChuyenBay?.MaTuyenNavigation?.MaSbdiNavigation?.TenSb) 
                        <i class="bi bi-arrow-right mx-1"></i> 
                        @(ViewBag.ChuyenBay?.MaTuyenNavigation?.MaSbdenNavigation?.TenSb) 
                        | @(ViewBag.ChuyenBay?.NgayGioBay.ToString("dd/MM/yyyy"))
                    </div>
                    <div id="selectedSeatsContainer" class="d-flex flex-wrap justify-content-center gap-2 mt-2">
                        <div class="badge bg-secondary px-3 py-2 fs-6" id="badgeSeatId">Chưa chọn ghế</div>
                    </div>
                </div>

                <div class="section-title">QUYỀN LỢI & ĐIỀU KIỆN</div>
                <ul class="info-list">
                    <li>
                        <div><i class="bi bi-briefcase me-3"></i><span class="fw-bold text-dark">Xách tay</span></div>
                        <span class="text-muted fw-bold" id="cond-carryon">--</span>
                    </li>
                    <li>
                        <div><i class="bi bi-luggage me-3"></i><span class="fw-bold text-dark">Ký gửi</span></div>
                        <span class="text-muted fw-bold" id="cond-checked">--</span>
                    </li>
                    <li class="flex-column align-items-start gap-2">
                        <div><i class="bi bi-star-fill me-3"></i><span class="fw-bold text-dark">Dịch vụ</span></div>
                        <div class="text-muted small w-100" id="cond-amenities">
                            <div class="text-end">--</div>
                        </div>
                    </li>
                </ul>

                <div class="section-title mt-4">CHI TIẾT THANH TOÁN</div>
                <div class="bill-summary" id="billSummaryContainer">
                    <div class="bill-row">
                        <span id="labelBasePrice">Giá vé</span>
                        <span class="fw-bold" id="billBasePrice">0 đ</span>
                        <input type="hidden" id="hiddenBasePrice" value="@(ViewBag.ChuyenBay?.GiaVeCoBan ?? 0)" />
                    </div>
                    <div id="dynamicSeatRows">
                        <div class="bill-row text-muted small">
                            <span>Phụ thu ghế</span>
                            <span>0 đ</span>
                        </div>
                    </div>
                    <div class="bill-row">
                        <span class="fw-bold">TỔNG TIỀN</span>
                        <span id="billTotal" class="fw-bold fs-5 text-primary">0 đ</span>
                    </div>
                </div>

                <button class="btn-checkout" id="btnConfirm" disabled onclick="submitSelection()">
                    <span>TIẾP TỤC ĐIỀN THÔNG TIN</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </div>

    </div>
</div>

<script src="~/user/js/ChonCho.js" asp-append-version="true" defer></script>