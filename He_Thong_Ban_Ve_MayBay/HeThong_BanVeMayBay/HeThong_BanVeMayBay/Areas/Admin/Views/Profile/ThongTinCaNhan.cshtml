@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Thông tin cá nhân Admin";
    Layout = "_LayoutAdmin";
}
@section Styles {
    <link rel="stylesheet" href="~/admin/css/ThongTinCaNhan.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
}

<div class="profile-container py-4">
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-4 mb-4">
                <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
                    <div class="card-body p-0">
                        <div class="bg-primary p-5 text-center text-white">
                            <div class="position-relative d-inline-block">
                                <img id="sideAvatar" src="https://ui-avatars.com/api/?name=Admin&background=ffffff&color=003580&size=128" 
                                     class="rounded-circle border border-4 border-white shadow" style="width: 120px; height: 120px; object-fit: cover;">
                                <button class="btn btn-sm btn-light rounded-circle position-absolute bottom-0 end-0 shadow-sm" 
                                        onclick="document.getElementById('fileAvatar').click()">
                                    <i class="bi bi-camera-fill"></i>
                                </button>
                                <input type="file" id="fileAvatar" hidden accept="image/*">
                            </div>
                            <h5 id="sideFullName" class="mt-3 fw-bold mb-1">...</h5>
                            <p id="sidePosition" class="mb-0 opacity-75 small">...</p>
                        </div>
                        <div class="p-4">
                            <div class="nav flex-column gap-2 profile-nav">
                                <a class="nav-link profile-nav-link active rounded-3 p-3" href="javascript:void(0)" onclick="switchTab(this, 'profile')">
                                    <i class="bi bi-person-badge me-3"></i>Hồ sơ nhân sự
                                </a>
                                <a class="nav-link profile-nav-link rounded-3 p-3" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#changePassModal" onclick="switchTab(this, 'security')">
                                    <i class="bi bi-shield-lock me-3"></i>Bảo mật tài khoản
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mt-4 border-0 rounded-4 shadow-sm p-4 bg-white">
                    <div class="d-flex align-items-center">
                        <div class="p-3 bg-primary-subtle rounded-4 me-3">
                            <i class="bi bi-calendar-check text-primary fs-3"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 1px;">Ngày vào làm</small>
                            <span id="sideJoinDate" class="fw-bold text-primary">...</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-8">
                <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 bg-white">
                    <div class="d-flex justify-content-between align-items-center mb-5">
                        <h4 class="section-title mb-0 text-uppercase">Hồ Sơ Nhân Viên</h4>
                        <span class="badge-admin">Thông tin quản trị</span>
                    </div>

                    <form id="profileForm">
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Họ và tên</label>
                                <input type="text" id="txtFullName" class="form-control form-control-lg bg-light border-0" placeholder="Nhập họ và tên">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Giới tính</label>
                                <select id="selGender" class="form-select form-select-lg bg-light border-0">
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Ngày sinh</label>
                                <input type="text" id="txtBirthDate" class="form-control form-control-lg bg-light border-0" placeholder="dd/mm/yyyy">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Số CCCD</label>
                                <input type="text" id="txtCccd" class="form-control form-control-lg bg-light border-0" placeholder="Nhập số CCCD">
                            </div>
                        </div>

                        <h5 class="mt-5 mb-4 fw-bold text-primary border-bottom pb-2">Liên lạc & Công việc</h5>
                        
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Số điện thoại</label>
                                <input type="text" id="txtPhone" class="form-control form-control-lg bg-light border-0" placeholder="Nhập số điện thoại">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Email công việc</label>
                                <input type="email" id="txtEmail" class="form-control form-control-lg bg-light border-0" placeholder="Nhập địa chỉ email">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted text-uppercase">Địa chỉ thường trú</label>
                            <textarea id="txtAddress" class="form-control form-control-lg bg-light border-0" rows="3" placeholder="Nhập địa chỉ của bạn"></textarea>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Chức vụ hiện tại</label>
                                <input type="text" id="txtPosition" class="form-control form-control-lg bg-white border" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Ngày bổ nhiệm</label>
                                <input type="text" id="txtJoinDate" class="form-control form-control-lg bg-white border" readonly>
                            </div>
                        </div>

                        <div class="pt-4 border-top mt-5 d-flex justify-content-end">
                            <button type="button" id="btnUpdateProfile" class="btn btn-primary px-5 py-3 fw-bold rounded-pill shadow">
                                <i class="bi bi-save me-2"></i>CẬP NHẬT THÔNG TIN
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Đổi mật khẩu -->
<div class="modal fade" id="changePassModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header bg-primary text-white border-0 rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="bi bi-key-fill me-2"></i>Bảo mật tài khoản</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="changePassForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Mật khẩu hiện tại</label>
                        <input type="password" id="txtOldPass" class="form-control form-control-lg" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Mật khẩu mới</label>
                        <input type="password" id="txtNewPass" class="form-control form-control-lg" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold small">Xác nhận mật khẩu mới</label>
                        <input type="password" id="txtConfirmPass" class="form-control form-control-lg" required>
                    </div>
                    <button type="button" id="btnConfirmChangePass" class="btn btn-primary w-100 py-3 fw-bold rounded-3">ĐỔI MẬT KHẨU NGAY</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/vn.js"></script>
    <script src="~/admin/js/ThongTinCaNhan.js" asp-append-version="true" defer></script>
}
