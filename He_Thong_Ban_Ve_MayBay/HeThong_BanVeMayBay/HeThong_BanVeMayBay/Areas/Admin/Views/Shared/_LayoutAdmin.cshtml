@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;

    // Thêm dấu ? vào string? action để cho phép giá trị null
    string ActiveClass(string area, string controller, string? action = null)
    {
        var rd = ViewContext.RouteData;
        var ra = (rd.Values["area"] ?? "").ToString();
        var rc = (rd.Values["controller"] ?? "").ToString();
        var raAction = (rd.Values["action"] ?? "").ToString();

        if (!string.IsNullOrEmpty(area) && !string.Equals(ra, area, StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }
        if (!string.IsNullOrEmpty(controller) && !string.Equals(rc, controller, StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }
        if (!string.IsNullOrEmpty(action) && !string.Equals(raAction, action, StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }
        return "active";
    }

    bool HasPermission(string permission)
    {
        var userPermissions = Context.Session.GetString("UserPermissions") ?? "";
        if (userPermissions == "ALL") return true;
        var list = userPermissions.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(p => p.Trim()).ToList();
        return list.Contains(permission);
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/admin/css/Admin.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <div id="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-airplane-engines-fill me-2 text-warning"></i>SkyBooking
            <div style="font-size: 10px; opacity: 0.6; letter-spacing: 1px;">HỆ THỐNG QUẢN TRỊ</div>
        </div>
        <nav class="mt-3">
            @if (HasPermission("DASHBOARD"))
            {
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="nav-link @(ActiveClass("Admin","Home","Index"))"><i class="bi bi-house-fill"></i> Dashboard</a>
            }

            @if (HasPermission("AIRPORT_ROUTE"))
            {
                <a asp-area="Admin" asp-controller="Flight" asp-action="SanBayVaTuyenBay" class="nav-link @(ActiveClass("Admin","Flight","SanBayVaTuyenBay"))">
                    <i class="bi bi-geo-alt-fill"></i> Sân bay & Tuyến bay
                </a>
            }

            @if (HasPermission("FLIGHT_MGMT"))
            {
                <a asp-area="Admin" asp-controller="Flight" asp-action="QuanLyChuyenBay" class="nav-link @(ActiveClass("Admin", "Flight", "QuanLyChuyenBay"))">
                    <i class="bi bi-airplane-fill"></i> Quản lý Chuyến bay
                </a>
            }

            @if (HasPermission("AIRCRAFT_MGMT"))
            {
                <a asp-area="Admin" asp-controller="Flight" asp-action="QuanLyMayBay" class="nav-link @(ActiveClass("Admin", "Flight", "QuanLyMayBay"))">
                    <i class="bi bi-airplane-engines-fill"></i> Quản lý Máy bay
                </a>
            }

            @if (HasPermission("SEAT_MAP"))
            {
                <a asp-area="Admin" asp-controller="Flight" asp-action="SoDoGhe" class="nav-link @(ActiveClass("Admin", "Flight", "SoDoGhe"))">
                    <i class="bi bi-grid-3x3-gap"></i> Sơ đồ ghế
                </a>
            }

            @if (HasPermission("BOOKING_MGMT"))
            {
                <a asp-area="Admin" asp-controller="Booking" asp-action="QuanLyDatVe" class="nav-link @(ActiveClass("Admin", "Booking", "QuanLyDatVe"))">
                    <i class="bi bi-ticket-perforated-fill"></i> Quản lý Đặt vé
                </a>
            }

            @if (HasPermission("USER_MGMT"))
            {
                <a asp-area="Admin" asp-controller="Account" asp-action="NhanVienVaKhachHang" class="nav-link @(ActiveClass("Admin", "Account", "NhanVienVaKhachHang"))">
                    <i class="bi bi-people-fill"></i> Nhân viên & Khách hàng
                </a>
            }

            @if (HasPermission("CABIN_CLASS"))
            {
                <a asp-area="Admin" asp-controller="Flight" asp-action="DanhMucHangGhe" class="nav-link @(ActiveClass("Admin","Flight","DanhMucHangGhe"))">
                    <i class="bi bi-star-fill"></i> Danh mục hạng ghế
                </a>
            }
        </nav>
    </div>

    <div class="topbar">
        <div class="search-box d-flex align-items-center">
            <i class="bi bi-search text-white opacity-50 me-2"></i>
            <input type="text" id="adminSearchInput" placeholder="Tìm kiếm nhanh trên trang..." class="form-control bg-transparent border-0 text-white shadow-none">
        </div>
        <ul class="navbar-nav ms-auto align-items-center">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                    @{
                        var userName = Context.Session.GetString("UserName") ?? "Khách";
                        var userAvatar = Context.Session.GetString("UserAvatar");
                        var avatarName = userName.Replace(" ", "+");
                        var finalAvatar = !string.IsNullOrEmpty(userAvatar) ? userAvatar : $"https://ui-avatars.com/api/?name={avatarName}&background=feba02&color=003580";
                    }
                    <span class="me-2 d-none d-lg-inline">@userName</span>
                    <img src="@finalAvatar" class="user-avatar" alt="User" style="object-fit: cover;">
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                    <li>
                        <a class="dropdown-item py-2" asp-area="Admin" asp-controller="Profile" asp-action="ThongTinCaNhan">
                            <i class="bi bi-person-circle me-2 text-primary"></i>Thông tin cá nhân
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item py-2 text-danger" asp-area="" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                        </a>
                    </li>
                </ul>
            </li>
        </ul>
    </div>

    <div class="main-content">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @RenderSection("Scripts", required: false)
    <script>
        $(document).ready(function () {
            // Live Search
            $("#adminSearchInput").on("keyup input", function () {
                var value = $(this).val().toLowerCase().trim();
                $("table tbody tr").each(function () {
                    var rowText = $(this).text().toLowerCase();
                    if (rowText.indexOf(value) > -1) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });

                $("table").each(function() {
                    var tbody = $(this).find("tbody");
                    var visibleRows = tbody.find("tr:visible").not(".no-result-row").length;
                    if (value !== "" && visibleRows === 0) {
                        if (tbody.find(".no-result-row").length === 0) {
                            var colCount = $(this).find("thead th").length || 10;
                            tbody.append('<tr class="no-result-row"><td colspan="' + colCount + '" class="text-center py-4 text-muted"><i class="bi bi-search me-2"></i>Không tìm thấy dữ liệu phù hợp với "' + value + '"</td></tr>');
                        }
                    } else {
                        tbody.find(".no-result-row").remove();
                    }
                });
            });
        });
    </script>
</body>
</html>