@{
    ViewData["Title"] = "Tổng quan hệ thống";
}

<link rel="stylesheet" href="~/admin/css/Dashboad.css" asp-append-version="true" />
<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h3 class="fw-bold">Tổng quan hệ thống</h3>
        <p class="text-muted small mb-0">Chào mừng quay trở lại. Đây là báo cáo vận hành hôm nay.</p>
    </div>
    <div>
        <a href="@Url.Action("ExportExcel", "Home", new { area = "Admin", year = DateTime.Now.Year })" id="btnExportExcel" class="btn btn-success shadow-sm px-4 rounded-pill me-2">
            <i class="bi bi-file-earmark-excel me-2"></i>Xuất báo cáo Excel
        </a>
        <a asp-action="ExportReport" asp-controller="Home" asp-area="Admin" class="btn btn-primary shadow-sm px-4 rounded-pill">
            <i class="bi bi-file-earmark-pdf me-2"></i>Xuất báo cáo PDF
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card-custom">
            <div class="d-flex justify-content-between mb-3">
                <div class="p-2 bg-primary-subtle text-primary rounded-3"><i class="bi bi-wallet2 fs-5"></i></div>
                <span class="badge bg-success-subtle text-success rounded-pill align-self-start">+12%</span>
            </div>
            <div class="text-muted small fw-bold">TỔNG DOANH THU</div>
            <h4 class="fw-bold my-1">@ViewBag.TotalRevenue.ToString("N0")</h4>
            <div class="text-muted small">VND • @(ViewBag.RevenueGrowth >= 0 ? "Tăng" : "Giảm") @Math.Abs(ViewBag.RevenueGrowth).ToString("0.1")% so với tháng trước</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom">
            <div class="d-flex justify-content-between mb-3">
                <div class="p-2 bg-warning-subtle text-warning rounded-3"><i class="bi bi-ticket-detailed fs-5"></i></div>
            </div>
            <div class="text-muted small fw-bold">VÉ ĐÃ BÁN</div>
            <h4 class="fw-bold my-1">@ViewBag.TotalTickets.ToString("N0")</h4>
            <div class="text-success small fw-bold"><i class="bi bi-check-circle me-1"></i>Đã xuất vé</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom bg-primary text-white">
            <div class="d-flex justify-content-between mb-3">
                <div class="p-2 bg-white bg-opacity-25 rounded-3"><i class="bi bi-airplane-engines fs-5"></i></div>
            </div>
            <div class="small opacity-75 fw-bold">TỔNG CHUYẾN BAY</div>
            <h4 class="fw-bold my-1">@ViewBag.TotalFlights Chuyến</h4>
            <div class="small fw-bold"><i class="bi bi-dot"></i> Đã có trên hệ thống</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom">
            <div class="d-flex justify-content-between mb-3">
                <div class="p-2 bg-info-subtle text-info rounded-3"><i class="bi bi-geo-alt fs-5"></i></div>
            </div>
            <div class="text-muted small fw-bold">TỔNG SỐ SÂN BAY</div>
            <h4 class="fw-bold my-1">@ViewBag.TotalAirports</h4>
            <div class="d-flex mt-2 text-muted small">
                Đang khai thác chặng bay
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-8">
        <div class="card-custom">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0">Biểu đồ Doanh thu</h5>
                <div class="d-flex align-items-center">
                    <select id="yearSelector" class="form-select form-select-sm rounded-pill px-3 border-primary" style="width: 120px;">
                        @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 2; y--)
                        {
                            <option value="@y">Năm @y</option>
                        }
                    </select>
                </div>
            </div>
            <div style="overflow-x: auto; overflow-y: hidden;">
                <div style="min-width: 600px;">
                    <canvas id="revenueChart" height="280"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-custom fleet-card">
            <h5 class="fw-bold mb-4">Tình trạng đội bay</h5>
            @if(ViewBag.FleetStatus != null)
            {
                foreach(var item in ViewBag.FleetStatus)
                {
                    <div class="mb-4">
                        <div class="d-flex justify-content-between small mb-2"><span>@item.Ten</span><span class="fw-bold">@item.DangBay / @item.Tong</span></div>
                        <div class="progress" style="height: 6px; background: rgba(255,255,255,0.1);"><div class="progress-bar bg-success" style="width: @(item.Tong > 0 ? (item.DangBay * 100 / item.Tong) : 0)%"></div></div>
                    </div>
                }
            }
            <div class="p-3 rounded-4 bg-white bg-opacity-10 small mt-auto">
                <i class="bi bi-info-circle me-2 text-warning"></i> <strong>Hoạt động:</strong> Các đội bay đang vận hành theo đúng lịch trình.
            </div>
        </div>
    </div>
</div>

<div class="card-custom">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold mb-0">Các chuyến bay gần đây</h5>
        <a asp-controller="Flight" asp-action="QuanLyChuyenBay" class="text-primary text-decoration-none small fw-bold">Xem tất cả lịch trình</a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr class="small text-muted">
                    <th>MÃ CHUYẾN BAY</th>
                    <th>HÀNH TRÌNH</th>
                    <th>THỜI GIAN BAY</th>
                    <th>LOẠI MÁY BAY</th>
                    <th>TÌNH TRẠNG</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if(ViewBag.RecentFlights != null)
                {
                    foreach(var flight in ViewBag.RecentFlights)
                    {
                        var fromS = flight.MaTuyenNavigation?.MaSbdiNavigation?.TenSb ?? "N/A";
                        var toS = flight.MaTuyenNavigation?.MaSbdenNavigation?.TenSb ?? "N/A";
                        <tr>
                            <td class="fw-bold">@flight.MaCb</td>
                            <td class="fw-bold">
                                @fromS <i class="bi bi-arrow-right mx-2 opacity-25"></i> @toS
                            </td>
                            <td>@flight.NgayGioBay.ToString("HH:mm dd/MM/yyyy")</td>
                            <td>@(flight.MaLoaiMbNavigation?.TenLoaiMb ?? "Chưa rõ")</td>
                            <td>
                                @if(flight.TrangThai == "Hoàn tất")
                                {
                                    <span class="status-badge bg-success-subtle text-success">ĐÃ HOÀN TẤT</span>
                                }
                                else if(flight.TrangThai == "Đã hủy")
                                {
                                    <span class="status-badge bg-danger-subtle text-danger">ĐÃ HỦY</span>
                                }
                                else
                                {
                                    <span class="status-badge bg-warning-subtle text-warning text-uppercase">@(flight.TrangThai ?? "Đang chờ")</span>
                                }
                            </td>
                            <td><i class="bi bi-three-dots-vertical cursor-pointer"></i></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

    <script>
        window.chartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartData));
        window.chartLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels));

        document.getElementById('yearSelector')?.addEventListener('change', function() {
            var selectedYear = this.value;
            var exportBtn = document.getElementById('btnExportExcel');
            if (exportBtn) {
                exportBtn.href = '/Admin/Home/ExportExcel?year=' + selectedYear;
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/admin/js/Dashboad.js" asp-append-version="true" defer></script>
