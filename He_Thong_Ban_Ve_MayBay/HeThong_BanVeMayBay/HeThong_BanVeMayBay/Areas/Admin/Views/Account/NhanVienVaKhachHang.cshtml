@{
    ViewData["Title"] = "Quản lý người dùng";
}


    <link rel="stylesheet" href="~/admin/css/NhanVienKhachhHang.css" asp-append-version="true" />


        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-navy mb-1" style="color: var(--primary-navy);">Nhân viên & Khách hàng</h3>
                <p class="text-muted small">Cấu hình tài khoản, phân quyền và lịch sử hoạt động.</p>
            </div>
            <button class="btn text-white rounded-pill px-4 fw-bold shadow-sm" style="background: var(--primary-navy);" onclick="openAddUserModal()">
                <i class="bi bi-person-plus-fill me-2"></i>Thêm người dùng mới
            </button>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-4"><div class="card-stat"><div class="text-muted small fw-bold text-uppercase">Tổng số tài khoản</div><h3 class="fw-bold mt-1">@ViewBag.TotalAccounts</h3></div></div>
            <div class="col-md-4"><div class="card-stat" style="border-color: #0ea5e9;"><div class="text-muted small fw-bold text-uppercase">Nhân viên </div><h3 class="fw-bold mt-1">@ViewBag.ActiveStaffs</h3></div></div>
            <div class="col-md-4"><div class="card-stat" style="border-color: #10b981;"><div class="text-muted small fw-bold text-uppercase">Số Khách hàng</div><h3 class="fw-bold mt-1">@ViewBag.TotalCustomers</h3></div></div>
        </div>

        <div class="user-table-container">
            <ul class="nav nav-tabs mb-4" id="userTab" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#staff-content">Nhân viên</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#customer-content">Khách hàng</button>
                </li>
            </ul>

            <div class="tab-content" id="userTabContent">
                <div class="tab-pane fade show active" id="staff-content">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr><th>ID</th><th>THÀNH VIÊN</th><th>CHỨC VỤ</th><th>TRẠNG THÁI</th><th class="text-end">THAO TÁC</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var nv in ViewBag.NhanViens)
                                {
                                    var isAdmin = nv.ChucVu != null && nv.ChucVu.Contains("Quản");
                                    var isActive = nv.MaTkNavigation?.TrangThai == true;
                                    <tr id="nv-@nv.MaNv">
                                        <td class="fw-bold text-primary">@nv.MaNv</td>
                                        <td>
                                            <div class="fw-bold">@nv.HoTen</div>
                                            <div class="small text-muted">@nv.Email</div>
                                        </td>
                                        <td>
                                            <span class="badge @(isAdmin ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary") rounded-pill px-3">
                                                @(nv.ChucVu ?? "Nhân viên")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="form-check form-switch status-toggle">
                                                <input class="form-check-input" type="checkbox" @(isActive ? "checked" : "") onchange="updateAccountStatus(@(nv.MaTk ?? 0), this.checked, 'staff')">
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn-action text-info" title="Xem chi tiết" onclick="openDetailModal('staff', '@nv.MaNv')"><i class="bi bi-info-circle"></i></button>
                                            @if (nv.MaTkNavigation?.LoaiTaiKhoan != "Admin")
                                            {
                                                <button class="btn-action text-primary" title="Phân quyền" onclick="openRoleModal('@nv.MaNv', '@nv.HoTen')"><i class="bi bi-shield-lock-fill"></i></button>
                                            }
                                            <button class="btn-action" title="Sửa" onclick="openEditUserModal('staff', '@nv.MaNv')"><i class="bi bi-pencil-square"></i></button>
                                            <button class="btn-action" title="Xóa" onclick="confirmDeleteAccount(@(nv.MaTk ?? 0), '@nv.HoTen', 'staff')"><i class="bi bi-trash text-danger"></i></button>
                                        </td>
                                    </tr>
                                }
                                @if(!Enumerable.Any(ViewBag.NhanViens))
                                {
                                    <tr><td colspan="5" class="text-center py-3 text-muted">Chưa có dữ liệu nhân viên.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="small text-muted fst-italic">Hiển thị trang @ViewBag.CurrentPageNv / @ViewBag.TotalPagesNv</div>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                @if (ViewBag.CurrentPageNv > 1)
                                {
                                    <li class="page-item"><a class="page-link" href="?pageNv=@(ViewBag.CurrentPageNv - 1)&pageKh=@ViewBag.CurrentPageKh#staff-content"><i class="bi bi-chevron-left"></i></a></li>
                                }
                                @for (int i = 1; i <= ViewBag.TotalPagesNv; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPageNv ? "active" : "")"><a class="page-link" href="?pageNv=@i&pageKh=@ViewBag.CurrentPageKh#staff-content">@i</a></li>
                                }
                                @if (ViewBag.CurrentPageNv < ViewBag.TotalPagesNv)
                                {
                                    <li class="page-item"><a class="page-link" href="?pageNv=@(ViewBag.CurrentPageNv + 1)&pageKh=@ViewBag.CurrentPageKh#staff-content"><i class="bi bi-chevron-right"></i></a></li>
                                }
                            </ul>
                        </nav>
                    </div>
                </div>

                <div class="tab-pane fade" id="customer-content">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr><th>MÃ KH</th><th>HỌ TÊN</th><th>LOẠI THÀNH VIÊN</th><th>ĐIỂM TÍCH LŨY</th><th class="text-end">THAO TÁC</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var kh in ViewBag.KhachHangs)
                                {
                                    var diem = kh.DiemTichLuy ?? 0;
                                    var loaiThe = (kh.LoaiThanhVien ?? "Thường").ToUpper();
                                    var badgeColor = "bg-light text-muted border";
                                    
                                    if (loaiThe.Contains("VÀNG") || loaiThe.Contains("GOLD")) badgeColor = "bg-warning text-dark";
                                    else if (loaiThe.Contains("BẠC") || loaiThe.Contains("SILVER")) badgeColor = "bg-secondary text-white";
                                    else if (loaiThe.Contains("KIM CƯƠNG") || loaiThe.Contains("DIAMOND")) badgeColor = "bg-primary text-white";

                                    <tr id="kh-@kh.MaKh">
                                        <td class="fw-bold text-primary">@kh.MaKh</td>
                                        <td>
                                            <div class="fw-bold">@kh.HoTen</div>
                                            <div class="small text-muted">@kh.SoDienThoai</div>
                                        </td>
                                        <td>
                                            <span class="badge @badgeColor px-3 py-2 rounded-3" style="font-size: 10px;">THÀNH VIÊN @loaiThe</span>
                                        </td>
                                        <td class="fw-bold text-primary">@diem.ToString("N0") pts</td>
                                        <td class="text-end">
                                            <button class="btn-action text-info" title="Xem chi tiết" onclick="openDetailModal('customer', '@kh.MaKh')"><i class="bi bi-info-circle"></i></button>
                                            <button class="btn-action text-primary" title="Lịch sử bay" onclick="openHistoryModal('@kh.MaKh')"><i class="bi bi-clock-history"></i></button>
                                            <button class="btn-action" title="Sửa tài khoản" onclick="openEditUserModal('customer', '@kh.MaKh')"><i class="bi bi-pencil-square"></i></button>
                                            <button class="btn-action" title="Xóa" onclick="confirmDeleteAccount(@(kh.MaTk ?? 0), '@kh.HoTen', 'customer')"><i class="bi bi-trash text-danger"></i></button>
                                        </td>
                                    </tr>
                                }
                                @if(!Enumerable.Any(ViewBag.KhachHangs))
                                {
                                    <tr><td colspan="5" class="text-center py-3 text-muted">Chưa có dữ liệu khách hàng.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="small text-muted fst-italic">Hiển thị trang @ViewBag.CurrentPageKh / @ViewBag.TotalPagesKh</div>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                @if (ViewBag.CurrentPageKh > 1)
                                {
                                    <li class="page-item"><a class="page-link" href="?pageKh=@(ViewBag.CurrentPageKh - 1)&pageNv=@ViewBag.CurrentPageNv#customer-content"><i class="bi bi-chevron-left"></i></a></li>
                                }
                                @for (int i = 1; i <= ViewBag.TotalPagesKh; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPageKh ? "active" : "")"><a class="page-link" href="?pageKh=@i&pageNv=@ViewBag.CurrentPageNv#customer-content">@i</a></li>
                                }
                                @if (ViewBag.CurrentPageKh < ViewBag.TotalPagesKh)
                                {
                                    <li class="page-item"><a class="page-link" href="?pageKh=@(ViewBag.CurrentPageKh + 1)&pageNv=@ViewBag.CurrentPageNv#customer-content"><i class="bi bi-chevron-right"></i></a></li>
                                }
                            </ul>
                        </nav>
                    </div>
                </div>
        <div class="modal fade" id="modalDetail" tabindex="-1">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg overflow-hidden" style="border-radius: 24px;">
                    <div class="modal-body p-0">
                        <div class="row g-0">
                            <!-- Cột trái: Profile tóm tắt -->
                            <div class="col-md-4 bg-light p-4 text-center border-end d-flex flex-column align-items-center justify-content-center">
                                <div class="position-relative d-inline-block mb-3">
                                    <div class="detail-avatar-wrapper shadow-sm">
                                        <img id="detailAvatar" src="/img/default-avatar.png" class="img-fluid rounded-circle h-100 w-100 object-fit-cover" onerror="this.src='https://ui-avatars.com/api/?background=random&name=User'">
                                    </div>
                                    <span class="status-indicator bg-success"></span>
                                </div>
                                <h5 class="fw-bold text-navy mb-1" id="detailName">--</h5>
                                <p class="text-muted small mb-3" id="detailCode">--</p>
                                <div id="detailBadgeContainer" class="mb-4"></div>
                                <button class="btn btn-copy-email w-100 rounded-pill shadow-sm" onclick="copyDetailEmail()">
                                    <i class="bi bi-clipboard-check me-2"></i>Sao chép Email
                                </button>
                            </div>

                            <!-- Cột phải: Thông tin chi tiết -->
                            <div class="col-md-8 p-4 bg-white position-relative">
                                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal"></button>

                                <div class="detail-section mb-4 mt-2">
                                    <h6 class="section-title"><i class="bi bi-person-badge me-2"></i>THÔNG TIN CÁ NHÂN</h6>
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <label class="detail-label">GIỚI TÍNH</label>
                                            <div class="detail-value" id="detailGender">--</div>
                                        </div>
                                        <div class="col-6">
                                            <label class="detail-label">NGÀY SINH</label>
                                            <div class="detail-value" id="detailBirthDate">--</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="detail-label">SỐ CCCD / PASSPORT</label>
                                            <div class="detail-value text-navy" id="detailCccd">--</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="detail-section">
                                    <h6 class="section-title"><i class="bi bi-geo-alt me-2"></i>LIÊN HỆ & CÔNG VIỆC</h6>
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <label class="detail-label">SỐ ĐIỆN THOẠI</label>
                                            <div class="detail-value" id="detailPhone">--</div>
                                        </div>
                                        <div class="col-6">
                                            <label class="detail-label">EMAIL</label>
                                            <div class="detail-value text-primary fw-medium" id="detailEmail" style="font-size: 0.85rem;">--</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="detail-label">ĐỊA CHỈ</label>
                                            <div class="detail-value" id="detailAddress">--</div>
                                        </div>
                                        <!-- Thông tin động -->
                                        <div class="col-6 staff-only">
                                            <label class="detail-label">CHỨC VỤ</label>
                                            <div class="detail-value fw-semibold" id="detailRole">--</div>
                                        </div>
                                        <div class="col-6 staff-only">
                                            <label class="detail-label">NGÀY VÀO LÀM</label>
                                            <div class="detail-value" id="detailJoined">--</div>
                                        </div>
                                        <div class="col-12 customer-only">
                                            <div class="loyalty-card-bg p-3 rounded-3 d-flex align-items-center justify-content-between">
                                                <div>
                                                    <label class="detail-label text-white-50">ĐIỂM TÍCH LŨY</label>
                                                    <div class="h4 mb-0 fw-bold text-white" id="detailPoints">0 pts</div>
                                                </div>
                                                <i class="bi bi-gem fs-2 opacity-50"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 bg-light p-3">
                        <button type="button" class="btn btn-white shadow-sm rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                        <button type="button" class="btn btn-primary rounded-pill px-4 shadow" onclick="editFromDetail()">
                            <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa hồ sơ
                        </button>
                    </div>
                </div>
            </div>
        </div>
    <div class="modal fade" id="modalAddUser" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="fw-bold mb-0 text-navy" id="modalAddUserTitle"><i class="bi bi-person-circle me-2"></i>Thêm Người dùng mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="userForm">
                        <input type="hidden" id="userId" value="">
                        <input type="hidden" id="userType" value="">
                        <input type="hidden" id="userAccountId" value="">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">LOẠI TÀI KHOẢN</label>
                            <select class="form-select bg-light border-0 py-2" id="accountTypeSelect">
                                @if (ViewBag.LoaiTaiKhoanList != null)
                                {
                                    foreach (var loai in ViewBag.LoaiTaiKhoanList)
                                    {
                                        <option value="@loai">@loai</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">HỌ VÀ TÊN</label>
                            <input type="text" class="form-control bg-light border-0 py-2" placeholder="VD: Nguyễn Văn A" id="userFullName" required>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold text-muted">GIỚI TÍNH</label>
                                <select class="form-select bg-light border-0 py-2" id="userGender">
                                    <option value="">-- Chọn --</option>
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold text-muted">NGÀY SINH</label>
                                <input type="date" class="form-control bg-light border-0 py-2" id="userBirthDate">
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold text-muted">SỐ ĐIỆN THOẠI</label>
                                <input type="text" class="form-control bg-light border-0 py-2" id="userPhone" required>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold text-muted">SỐ CCCD/PASSPORT</label>
                                <input type="text" class="form-control bg-light border-0 py-2" id="userCccd" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">EMAIL ĐĂNG NHẬP</label>
                            <input type="email" class="form-control bg-light border-0 py-2" placeholder="email@skybooking.vn" id="userEmail" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">MẬT KHẨU</label>
                            <input type="password" class="form-control bg-light border-0 py-2" id="userPassword" placeholder="Nhập mật khẩu">
                            <small class="text-muted">Để trống khi không muốn đổi mật khẩu.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">ĐỊA CHỈ</label>
                            <input type="text" class="form-control bg-light border-0 py-2" id="userAddress">
                        </div>
                        <div class="mb-3" id="roleField">
                            <label class="form-label small fw-bold text-muted">CHỨC VỤ</label>
                            <input type="text" class="form-control bg-light border-0 py-2" id="userRole" placeholder="VD: Admin, Nhân viên">
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn text-white rounded-pill px-4" style="background: var(--primary-navy);" onclick="saveUser()">Lưu thông tin</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalRole" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-light">
                    <h5 class="fw-bold mb-0 text-navy"><i class="bi bi-shield-lock-fill me-2 text-primary"></i>Phân quyền hệ thống</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                        <div class="bg-primary-subtle text-primary rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 50px; height: 50px;">
                            <i class="bi bi-person-fill fs-3"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0" id="roleUserName">Nguyễn Admin</h6>
                            <small class="text-muted">Nhân viên hệ thống</small>
                        </div>
                    </div>
                    
                    <p class="small fw-bold text-muted mb-3">DANH SÁCH QUYỀN TRUY CẬP:</p>
                    
                    <input type="hidden" id="roleUserId" value="">
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded-3 mb-2">
                                <div class="fw-bold small"><i class="bi bi-house-fill me-2 text-muted"></i>Dashboard</div>
                                <div class="form-check form-switch"><input class="form-check-input role-switch" type="checkbox" id="role_DASHBOARD"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded-3 mb-2">
                                <div class="fw-bold small"><i class="bi bi-geo-alt-fill me-2 text-muted"></i>Sân bay & Tuyến bay</div>
                                <div class="form-check form-switch"><input class="form-check-input role-switch" type="checkbox" id="role_AIRPORT_ROUTE"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded-3 mb-2">
                                <div class="fw-bold small"><i class="bi bi-airplane-fill me-2 text-muted"></i>Quản lý Chuyến bay</div>
                                <div class="form-check form-switch"><input class="form-check-input role-switch" type="checkbox" id="role_FLIGHT_MGMT"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded-3 mb-2">
                                <div class="fw-bold small"><i class="bi bi-airplane-engines-fill me-2 text-muted"></i>Quản lý Máy bay</div>
                                <div class="form-check form-switch"><input class="form-check-input role-switch" type="checkbox" id="role_AIRCRAFT_MGMT"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded-3 mb-2">
                                <div class="fw-bold small"><i class="bi bi-grid-3x3-gap me-2 text-muted"></i>Sơ đồ ghế</div>
                                <div class="form-check form-switch"><input class="form-check-input role-switch" type="checkbox" id="role_SEAT_MAP"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded-3 mb-2">
                                <div class="fw-bold small"><i class="bi bi-ticket-perforated-fill me-2 text-muted"></i>Quản lý Đặt vé</div>
                                <div class="form-check form-switch"><input class="form-check-input role-switch" type="checkbox" id="role_BOOKING_MGMT"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded-3 mb-2">
                                <div class="fw-bold small"><i class="bi bi-people-fill me-2 text-muted"></i>Nhân viên & Khách hàng</div>
                                <div class="form-check form-switch"><input class="form-check-input role-switch" type="checkbox" id="role_USER_MGMT"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded-3 mb-2">
                                <div class="fw-bold small"><i class="bi bi-star-fill me-2 text-muted"></i>Danh mục hạng ghế</div>
                                <div class="form-check form-switch"><input class="form-check-input role-switch" type="checkbox" id="role_CABIN_CLASS"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn text-white rounded-pill px-4 w-100" style="background: var(--primary-navy);" onclick="saveRoles()">Xác nhận quyền</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalHistory" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="fw-bold mb-0 text-navy"><i class="bi bi-clock-history me-2"></i>Lịch sử chuyến bay</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="p-3 bg-light border-bottom d-flex align-items-center" id="historyHeader">
                        <span class="badge bg-secondary me-3" id="historyBadge">Thành viên</span>
                        <span class="fw-bold" id="historyName">--</span>
                        <span class="text-muted ms-auto small" id="historyTotal">Tổng số: 0 chuyến</span>
                    </div>
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-muted"><th>MÃ VÉ</th><th>HÀNH TRÌNH</th><th>NGÀY BAY</th><th>TRẠNG THÁI</th></tr>
                        </thead>
                        <tbody id="historyTableBody">
                            <tr><td colspan="4" class="text-center text-muted py-4">Chưa có dữ liệu lịch sử.</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalConfirm" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content shadow-lg text-center p-4">
                <i class="bi bi-exclamation-circle text-danger display-4 mb-3"></i>
                <h5 class="fw-bold mb-2">Xác nhận thao tác</h5>
                <p class="text-muted small mb-4" id="confirmText">Bạn có chắc chắn thực hiện hành động này?</p>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-light w-50 fw-bold" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-danger w-50 fw-bold" id="btnConfirmAction">Khóa</button>
                </div>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 1060; margin-top: 20px;">
        <div id="liveToast" class="toast align-items-center text-white bg-success border-0 shadow-lg rounded-pill px-3 py-2" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body fw-bold fs-6" id="toastMessage">Thao tác thành công!</div>
            </div>
        </div>
    </div>


