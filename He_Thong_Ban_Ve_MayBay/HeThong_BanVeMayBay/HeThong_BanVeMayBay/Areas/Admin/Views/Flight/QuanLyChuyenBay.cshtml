@model IEnumerable<HeThong_BanVeMayBay.Models.Entities.ChuyenBay>
@{
    ViewData["Title"] = "Quản lý Chuyến bay";

    // Tính toán số liệu thống kê từ Model
    var totalFlights = Model?.Count() ?? 0;
    var onTimeFlights = Model?.Count(f => f.TrangThai == "Đúng giờ") ?? 0;
    var delayFlights = Model?.Count(f => f.TrangThai == "Delay") ?? 0;
    var onTimePercentage = totalFlights > 0 ? (onTimeFlights * 100.0 / totalFlights).ToString("0.0") : "0";
    var popularPlane = Model?.GroupBy(f => f.MaLoaiMbNavigation?.TenLoaiMb).OrderByDescending(g => g.Count()).FirstOrDefault()?.Key ?? "N/A";
}

<link href="~/admin/css/QuanLyChuyenBay.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-navy mb-1">Quản lý Chuyến bay</h3>
        <p class="text-muted small mb-0">Cập nhật và theo dõi lộ trình bay trong thời gian thực.</p>
    </div>
    <!-- Đã sửa: Xóa data-bs-toggle để JS tự mở Modal, thêm sự kiện onclick -->
    <button class="btn btn-add" onclick="openAddModal()" style="background: var(--primary-navy, #003580); color: white; border-radius: 50px; padding: 10px 25px; font-weight: bold; border: none;">
        <i class="bi bi-plus-lg me-2"></i>Thêm Chuyến bay
    </button>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card-custom d-flex justify-content-between align-items-center" style="background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
            <div>
                <div class="stat-label small fw-bold text-muted text-uppercase mb-1">Tổng chuyến bay</div>
                <h3 class="fw-bold mb-0">@totalFlights</h3>
            </div>
            <span class="badge bg-primary-subtle text-primary rounded-pill">Chuyến</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom" style="background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
            <div class="stat-label small fw-bold text-muted text-uppercase mb-1">Đúng giờ</div>
            <div class="d-flex align-items-center">
                <h3 class="fw-bold mb-0 me-3">@onTimeFlights</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom" style="background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
            <div class="stat-label small fw-bold text-muted text-uppercase mb-1">Đang Delay</div>
            <div class="d-flex align-items-center">
                <h3 class="fw-bold mb-0 me-3 text-danger">@delayFlights</h3>
                <span class="badge bg-danger-subtle text-danger rounded-pill">Chú ý</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom" style="background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
            <div class="stat-label small fw-bold text-muted text-uppercase mb-1">Loại máy bay</div>
            <div class="d-flex align-items-center">
                <h3 class="fw-bold mb-0 me-3">@popularPlane</h3>
                <span class="badge bg-warning-subtle text-warning rounded-pill">Phổ biến</span>
            </div>
        </div>
    </div>
</div>

<div class="table-container mb-5" style="background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold mb-0">Danh sách lộ trình</h5>
        <div class="d-flex gap-2">
            <button class="btn btn-light btn-sm rounded-pill px-3 active fw-bold" style="background: #003580; color: white;">Tất cả</button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle" id="flightTable">
            <thead class="bg-light text-muted small text-uppercase" style="border-bottom: 2px solid #eee;">
                <tr>
                    <th class="py-3 border-0">Mã CB</th>
                    <th class="py-3 border-0">Tuyến bay</th>
                    <th class="py-3 border-0">Ngày giờ khởi hành</th>
                    <th class="py-3 border-0">Loại máy bay</th>

                    <!-- THÊM CỘT GIÁ VÉ VÀO ĐÂY -->
                    <th class="py-3 border-0">Giá vé (VNĐ)</th>

                    <th class="py-3 border-0">Trạng thái</th>
                    <th class="py-3 border-0 text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var flight in Model)
                    {
                        var from = flight.MaTuyenNavigation?.MaSbdiNavigation?.MaSb ?? flight.MaTuyenNavigation?.MaSbdi ?? "N/A";
                        var to = flight.MaTuyenNavigation?.MaSbdenNavigation?.MaSb ?? flight.MaTuyenNavigation?.MaSbden ?? "N/A";
                        var airplane = flight.MaLoaiMbNavigation?.TenLoaiMb ?? "N/A";

                        // Xử lý biến trạng thái (bắt null)
                        var status = flight.TrangThai ?? "Sắp bay";

                        <tr id="row-@flight.MaCb">
                            <td class="fw-bold text-primary">@flight.MaCb</td>
                            <td class="fw-bold">@from <i class="bi bi-arrow-right mx-2 opacity-25"></i> @to</td>
                            <td>
                                <div class="fw-bold text-dark">@(flight.NgayGioBay.ToString("dd/MM/yyyy") ?? "N/A")</div>
                                @if (status == "Delay")
                                {
                                    <div class="small text-danger">@(flight.NgayGioBay.ToString("HH:mm") ?? "") (Dự kiến)</div>
                                }
                                else
                                {
                                    <div class="small text-muted">@(flight.NgayGioBay.ToString("HH:mm") ?? "")</div>
                                }
                            </td>
                            <td>@airplane</td>

                            <!-- THÊM DỮ LIỆU GIÁ VÉ VÀO ĐÂY (Format số có dấu phẩy) -->
                            <td class="fw-bold text-success">
                                @(flight.GiaVeCoBan != null ? string.Format("{0:N0}", flight.GiaVeCoBan) : "0") ₫
                            </td>

                            <td>
                                @if (status == "Đúng giờ")
                                {
                                    <span class="status-pill status-ontime" style="background: #d1fae5; color: #059669; padding: 6px 12px; border-radius: 50px; font-weight: bold; font-size: 12px;"><i class="bi bi-check-circle-fill me-1"></i>Đúng giờ</span>
                                }
                                else if (status == "Delay")
                                {
                                    <span class="status-pill status-delay" style="background: #fee2e2; color: #dc2626; padding: 6px 12px; border-radius: 50px; font-weight: bold; font-size: 12px;"><i class="bi bi-exclamation-circle-fill me-1"></i>Delay</span>
                                }
                                else if (status == "Sắp bay")
                                {
                                    <span class="status-pill" style="background: #e0f2fe; color: #0284c7; padding: 6px 12px; border-radius: 50px; font-weight: bold; font-size: 12px;"><i class="bi bi-calendar-event me-1"></i>Sắp bay</span>
                                }
                                else if (status == "Đang bay")
                                {
                                    <span class="status-pill" style="background: #fef08a; color: #b45309; padding: 6px 12px; border-radius: 50px; font-weight: bold; font-size: 12px;"><i class="bi bi-airplane-engines me-1"></i>Đang bay</span>
                                }
                                else if (status == "Đã hạ cánh")
                                {
                                    <span class="status-pill" style="background: #f1f5f9; color: #475569; padding: 6px 12px; border-radius: 50px; font-weight: bold; font-size: 12px;"><i class="bi bi-geo-alt-fill me-1"></i>Đã hạ cánh</span>
                                }
                                else if (status == "Hủy chuyến")
                                {
                                    <span class="status-pill" style="background: #111827; color: #f9fafb; padding: 6px 12px; border-radius: 50px; font-weight: bold; font-size: 12px;"><i class="bi bi-x-circle-fill me-1"></i>Hủy chuyến</span>
                                }
                                else
                                {
                                    <span class="status-pill" style="background: #f1f5f9; color: #475569; padding: 6px 12px; border-radius: 50px; font-weight: bold; font-size: 12px;">@status</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn-action btn-view" title="Xem" onclick="openViewModal('@flight.MaCb')" style="width: 32px; height: 32px; border-radius: 8px; border: none; background: #e0e7ff; color: #4f46e5; margin-left: 4px;"><i class="bi bi-eye"></i></button>
                                <button class="btn-action btn-edit" title="Sửa" onclick="openEditModal('@flight.MaCb')" style="width: 32px; height: 32px; border-radius: 8px; border: none; background: #fef08a; color: #d97706; margin-left: 4px;"><i class="bi bi-pencil-square"></i></button>
                                <button class="btn-action btn-delete" title="Xóa" onclick="openDeleteModal('@flight.MaCb')" style="width: 32px; height: 32px; border-radius: 8px; border: none; background: #fee2e2; color: #dc2626; margin-left: 4px;"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Chưa có dữ liệu chuyến bay.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!-- Pagination Động -->
    <div class="d-flex justify-content-between align-items-center mt-4 border-top pt-3">
        <div class="small text-muted fst-italic">Trang @ViewBag.CurrentPage / @ViewBag.TotalPages</div>
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0">
                @if (ViewBag.CurrentPage > 1)
                {
                    <li class="page-item"><a class="page-link border-0 fw-bold text-muted rounded-3" href="?page=@(ViewBag.CurrentPage - 1)"><i class="bi bi-chevron-left"></i></a></li>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    if (i == ViewBag.CurrentPage)
                    {
                        <li class="page-item active"><a class="page-link border-0 text-white rounded-3 mx-1" style="background:#003580;" href="#">@i</a></li>
                    }
                    else
                    {
                        <li class="page-item"><a class="page-link border-0 text-muted fw-bold rounded-3 mx-1" href="?page=@i">@i</a></li>
                    }
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <li class="page-item"><a class="page-link border-0 text-muted fw-bold rounded-3" href="?page=@(ViewBag.CurrentPage + 1)"><i class="bi bi-chevron-right"></i></a></li>
                }
            </ul>
        </nav>
    </div>
</div>

<!-- Modal Thêm/Sửa Chuyến Bay -->
<div class="modal fade" id="modalFlight" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="fw-bold mb-0" id="modalFlightTitle" style="color: var(--primary-navy, #003580);"><i class="bi bi-airplane-engines me-2"></i>Thêm Chuyến bay mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Đã thêm form onsubmit để gọi sự kiện JS -->
                <!-- Đã thêm form onsubmit để gọi sự kiện JS -->
                <form id="flightForm" onsubmit="submitFlightForm(event)" novalidate>
                    <div id="editNotice" class="alert alert-warning text-center" style="display: none; font-size: 13px; font-weight: bold; border-radius: 10px;"></div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">MÃ CHUYẾN BAY</label>
                        <input type="text" class="form-control bg-light border-0 py-2 fw-bold" id="fCode" placeholder="VD: VN123" required>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">TUYẾN BAY</label>
                            <select class="form-select bg-light border-0 py-2 fw-bold" id="fRoute" required>
                                <option value="">-- Chọn tuyến bay --</option>
                                @if (ViewBag.DanhSachTuyenBay != null)
                                {
                                    foreach (var tb in ViewBag.DanhSachTuyenBay)
                                    {
                                        <option value="@tb.MaTuyen">@tb.MaSbdi - @tb.MaSbden</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">MÁY BAY</label>
                            <select class="form-select bg-light border-0 py-2 fw-bold" id="fPlane" required>
                                <option value="">-- Chọn máy bay --</option>
                                @if (ViewBag.DanhSachMayBay != null)
                                {
                                    foreach (var mb in ViewBag.DanhSachMayBay)
                                    {
                                        <option value="@mb.MaLoaiMb">@mb.TenLoaiMb</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Ngày giờ và Trạng thái -->
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">NGÀY GIỜ KHỞI HÀNH</label>
                            <input type="datetime-local" class="form-control bg-light border-0 py-2" id="fDate" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">TRẠNG THÁI</label>
                            <select class="form-select bg-light border-0 py-2 fw-bold" id="fStatus">
                                <option value="Sắp bay">Sắp bay</option>
                                <option value="Đúng giờ">Đúng giờ</option>
                                <option value="Delay">Delay</option>
                                <option value="Đang bay">Đang bay</option>
                                <option value="Đã hạ cánh">Đã hạ cánh</option>
                                <option value="Hủy chuyến">Hủy chuyến</option>
                            </select>
                        </div>
                    </div>

                    <!-- ĐÃ THÊM: Ô nhập Giá vé cơ bản -->
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">GIÁ VÉ CƠ BẢN</label>
                            <div class="input-group">
                                <input type="number" class="form-control bg-light border-0 py-2 fw-bold text-success" id="fPrice" placeholder="Nhập giá vé... (VD: 1500000)" min="0" required>
                                <span class="input-group-text bg-light border-0 fw-bold text-muted">VNĐ</span>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn w-100 rounded-pill py-3 fw-bold text-white shadow-sm" style="background: var(--primary-navy, #003580);">LƯU THÔNG TIN</button>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Modal Xem Chi Tiết -->
<div class="modal fade" id="modalView" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: 20px; overflow: hidden;">

            <!-- Header -->
            <div class="modal-header border-0 text-white" style="background: var(--primary-navy, #003580); padding: 20px 30px;">
                <div class="d-flex align-items-center w-100">
                    <div class="bg-white bg-opacity-25 rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 50px; height: 50px;">
                        <i class="bi bi-airplane-fill fs-3" style="transform: rotate(45deg);"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h3 class="fw-bold mb-0" id="viewCode">VN123</h3>
                        <div class="opacity-75" id="viewDate"><i class="bi bi-calendar-event me-2"></i>15/06/2026</div>
                    </div>
                    <div class="text-end">
                        <span id="viewStatus" class="badge bg-white text-primary px-3 py-2 rounded-pill fs-6 fw-bold shadow-sm">Đúng giờ</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body bg-light p-4">
                <!-- Lộ trình bay (Timeline) -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h6 class="fw-bold text-muted text-uppercase small mb-4"><i class="bi bi-geo-alt-fill me-2 text-danger"></i>Lộ trình bay</h6>
                    <div class="row align-items-center position-relative text-center">
                        <div class="position-absolute top-50 start-50 translate-middle w-75" style="height: 2px; border-top: 2px dashed #cbd5e1; z-index: 1;"></div>

                        <!-- Điểm Đi -->
                        <div class="col-5 position-relative z-2 bg-white rounded-3 py-2">
                            <h1 class="fw-bold text-navy mb-0 display-6" id="viewSbDi">HAN</h1>
                            <h5 class="fw-bold mb-1" id="viewThanhPhoDi">Hà Nội</h5>
                            <span class="text-muted small" id="viewTenSbDi">Sân bay Nội Bài</span>
                        </div>

                        <!-- Icon Máy bay giữa -->
                        <div class="col-2 position-relative z-2 bg-white d-flex flex-column justify-content-center">
                            <i class="bi bi-airplane-fill fs-3 text-primary" style="transform: rotate(90deg);"></i>
                        </div>

                        <!-- Điểm Đến -->
                        <div class="col-5 position-relative z-2 bg-white rounded-3 py-2">
                            <h1 class="fw-bold text-navy mb-0 display-6" id="viewSbDen">SGN</h1>
                            <h5 class="fw-bold mb-1" id="viewThanhPhoDen">Hồ Chí Minh</h5>
                            <span class="text-muted small" id="viewTenSbDen">Sân bay Tân Sơn Nhất</span>
                        </div>
                    </div>
                </div>

                <!-- Thông tin kỹ thuật & Thương mại -->
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 p-4 h-100 border-start border-4 border-primary">
                            <h6 class="fw-bold text-muted text-uppercase small mb-3"><i class="bi bi-gear-fill me-2"></i>Tàu bay vận hành</h6>
                            <h5 class="fw-bold text-dark mb-1" id="viewPlane">Airbus A321</h5>
                            <div class="text-muted small">Hãng sản xuất: <span id="viewHangSX" class="fw-bold">Airbus</span></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 p-4 h-100 border-start border-4 border-success">
                            <h6 class="fw-bold text-muted text-uppercase small mb-3"><i class="bi bi-tag-fill me-2"></i>Giá vé cơ bản</h6>
                            <h4 class="fw-bold text-success mb-0" id="viewPrice">1,500,000 VNĐ</h4>
                            <div class="text-muted small mt-1">Chưa bao gồm thuế, phí & tiện ích</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 p-3 bg-white justify-content-center">
                <button type="button" class="btn rounded-pill px-5 py-2 fw-bold text-white w-100" style="background: var(--primary-navy, #003580); font-size: 1.1rem;" data-bs-dismiss="modal">Đóng cửa sổ</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal Delete -->
<div class="modal fade" id="modalDelete" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content shadow-lg text-center p-4" style="border-radius: 20px; border: none;">
            <i class="bi bi-exclamation-triangle-fill text-danger display-4 mb-3"></i>
            <h5 class="fw-bold mb-2">Xác nhận xóa?</h5>
            <p class="text-muted small mb-4">Bạn có chắc muốn xóa chuyến bay <strong id="delFlightCode" class="text-dark"></strong> không? Hành động này không thể hoàn tác.</p>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light w-50 rounded-pill fw-bold" data-bs-dismiss="modal">Hủy</button>
                <!-- Đã update sự kiện onclick -->
                <button type="button" class="btn btn-danger w-50 rounded-pill fw-bold" onclick="confirmDelete()">Xóa bỏ</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Thông Báo -->
<div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 1060; margin-top: 20px;">
    <div id="liveToast" class="toast align-items-center text-white bg-success border-0 shadow-lg rounded-pill px-4 py-3" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-bold fs-6 p-0" id="toastMessage">
                Thao tác thành công!
            </div>
        </div>
    </div>
</div>

<script src="~/admin/js/QuanLyChuyenBay.js" asp-append-version="true" defer></script>